ROOT=$(dirname "$(dirname "$(realpath "${BASH_SOURCE[0]}")")")
EXEC_DIR=${PWD}
cd "$ROOT" || exit 1
# shellcheck disable=SC2016
exec "${ROOT}/bin/mise" exec -- bash -c 'cd "$1" && shift && exec "$@"' _ "$EXEC_DIR" aube "$@"
