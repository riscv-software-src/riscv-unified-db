#MISE description="Regression task translated from regress-native-bits"

set -e

# Step 1: Configure native Bits without hart or source generation
(
  cmake -S backends/cpp_hart_gen/cpp/test -B gen/native-bits -DCMAKE_CXX_COMPILER="$PWD/bin/g++" -DCMAKE_BUILD_TYPE=Debug
)

# Step 2: Build handwritten Bits targets
(
  cmake --build gen/native-bits --target test_bits_random test_bits_directed -j1
)

# Step 3: Check native Bits properties, defects and directed cases
(
  ctest --test-dir gen/native-bits -j1 --output-on-failure
)
