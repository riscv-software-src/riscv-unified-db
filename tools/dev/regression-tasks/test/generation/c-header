#MISE description="Regression task translated from regress-gen-c-header"

set -e

# Step 1: Generate generic C encoding header with Python
(
  uv run --locked python -m udb.generators.c_encoding -o gen/c_header/encoding.out.h
)

# Step 2: Require genuine all-code and interpolated-name prose parity
(
  uv run --locked python -m pytest -n 0 --basetemp=gen/c_header/prose-pytest tests/python/test_generic_codegen.py -k shared_prose_provider
)

# Step 3: Compile and execute every C declaration
(
  UDB_TEST_GENERIC_TOOLS=1 uv run --locked python -m pytest -n 0 --basetemp=gen/c_header/pytest tests/python/test_generic_codegen_consumers.py::test_c_all_instruction_csr_cause_consumer
)
