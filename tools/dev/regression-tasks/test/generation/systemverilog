#MISE description="Regression task translated from regress-gen-sverilog"

set -e

# Step 1: Generate SystemVerilog decode package with Python
(
  uv run --locked udb generate sv-decode -o gen/sverilog/riscv_decode_package.svh
)

# Step 2: Parse every SystemVerilog declaration and consumer reference
(
  UDB_TEST_GENERIC_TOOLS=1 uv run --locked python -m pytest -n 0 --basetemp=gen/sverilog/pytest tests/python/test_generic_codegen_consumers.py::test_sv_complete_decode_package_lints
)
