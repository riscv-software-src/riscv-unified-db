#MISE description="Regression task translated from regress-python-config-headers"

set -e

# Step 1: Generate configuration header artifacts with installed Python CLI
(
  uv run --locked udb generate config-c-header -c cfgs/mc100-32-full-example.yaml -o gen/config-headers/config.h
  uv run --locked udb generate config-sv-header -c cfgs/mc100-32-full-example.yaml -o gen/config-headers/config.svh
  cmp gen/config-headers/config.h tests/golden/mc100-32-full-example.golden.h
  cmp gen/config-headers/config.svh tests/golden/mc100-32-full-example.golden.svh
)

# Step 2: Check configuration header bytes and C/SystemVerilog consumers
(
  UDB_TEST_HEADER_TOOLS=1 uv run --locked python -m pytest -n 8 --basetemp=gen/config-headers/pytest tests/python/test_config_headers.py -k "not live_ruby"
)

# Step 3: Compare complete configuration header artifacts with Ruby
(
  UDB_TEST_RUBY=1 uv run --locked python -m pytest -n 0 --basetemp=gen/config-headers/pytest-ruby tests/python/test_config_headers.py -k live_ruby
)
