{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "v0.10",
  "oneOf": [{"$ref": "#/$defs/first_variant"}, {"$ref": "#/$defs/other_variant"}],
  "$defs": {
    "first_variant": {
      "description": "First <object>",
      "type": "object",
      "properties": {
        "type": {"type": "string", "const": "Full Variant!"},
        "value": {"enum": ["alpha", "beta"]}
      }
    },
    "other_variant": {
      "type": "object",
      "properties": {
        "type": {"type": "string", "const": "Other Variant"}
      }
    },
    "remote": {"type": "integer", "minimum": 0, "maximum": 15}
  }
}
