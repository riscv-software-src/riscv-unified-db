# yaml-language-server: $schema=../../../../../schemas/csr_schema.json

$schema: csr_schema.json#
kind: csr
name: qc.mclicie{{ index }}
long_name: IRQ Enable {{ number }}
address: {{ address }}
length: 32
priv_mode: M
definedBy:
  allOf:
    - xlen: 32
    - extension:
        name: Xqciint
writable: true
description: |
  Enable bits for IRQs {{ number * 32 }}-{{ (number + 1) * 32 - 1 }}
fields:
{% for field in field_numbers -%}
  IRQ{{ number * 32 + field }}:
    type: RW
    reset_value: 0
    location: {{ field }}
    description: IRQ{{ number * 32 + field }} enabled
{% endfor -%}
