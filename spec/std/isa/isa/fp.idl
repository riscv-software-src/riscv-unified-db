%version: 1.0

# Many functions in this file (and all prefixed with softfloat_*) are
# adapted from berkeley-softfloat-3 by John R. Hauser
# (https://github.com/ucb-bar/berkeley-softfloat-3)
# Files in berkely-softfloat-3 repository are licensed under BSD-3-clause.

# floating point register file
U32 FLEN = implemented?(ExtensionName::Q) ? 8'd128 : (implemented?(ExtensionName::D) ? 7'd64 : 7'd32);

# FP constants
Bits<32> SP_POS_INF       = 32'b0_11111111_00000000000000000000000;
Bits<32> SP_NEG_INF       = 32'b1_11111111_00000000000000000000000;
Bits<32> SP_POS_ZERO      = 32'b0_00000000_00000000000000000000000;
Bits<32> SP_NEG_ZERO      = 32'b1_00000000_00000000000000000000000;
Bits<32> SP_CANONICAL_NAN = 32'b0_11111111_10000000000000000000000;

Bits<16> HP_CANONICAL_NAN = 16'b0_11111_1000000000;

Bits<32> WORD_NEG_OVERFLOW = 32'h8000_0000; # minimum signed 32-bit integer
Bits<32> WORD_POS_OVERFLOW = 32'h7FFF_FFFF; # maximum signed 32-bit integer

Bits<32> UI32_NEG_OVERFLOW = 32'h0000_0000; # minimum unsigned 32-bit integer
Bits<32> UI32_POS_OVERFLOW = 32'hFFFF_FFFF; # maximum unsigned 32-bit integer

Bits<32> UI32_NAN          = 32'hFFFF_FFFF; # NaN to unsigned 32-bit integer
Bits<32> I32_NAN           = 32'h7FFF_FFFF; # NaN to signed 32-bit integer

Bits<64> I64_NEG_OVERFLOW  = 64'h8000_0000_0000_0000; # minimum signed 64-bit integer
Bits<64> I64_POS_OVERFLOW  = 64'h7FFF_FFFF_FFFF_FFFF; # maximum signed 64-bit integer
Bits<64> UI64_NEG_OVERFLOW = 64'h0000_0000_0000_0000; # minimum unsigned 64-bit integer
Bits<64> UI64_POS_OVERFLOW = 64'hFFFF_FFFF_FFFF_FFFF; # maximum unsigned 64-bit integer
Bits<64> UI64_NAN          = 64'hFFFF_FFFF_FFFF_FFFF; # NaN to unsigned 64-bit integer
Bits<64> I64_NAN           = 64'h7FFF_FFFF_FFFF_FFFF; # NaN to signed 64-bit integer

enum RoundingMode {
  RNE 0b000 # Round to Nearest, ties to Even
  RTZ 0b001 # Round toward Zero
  RDN 0b010 # Round Down (towards -&infin;)
  RUP 0b011 # Round Up (towards +&infin;)
  RMM 0b100 # Round to Nearest, ties to Max Magnitude
  DYN 0b111 # Dynamic; use rm field in instruction
}

enum FpFlag {
  NX 0b00001 # Inexact
  UF 0b00010 # Underflow
  OF 0b00100 # Overflow
  DZ 0b01000 # Divide by zero
  NV 0b10000 # Invalid Operation
}

# Operation modifier for fused multiply-add
enum F32MulAddOp {
  Softfloat_mulAdd_addC    0 # (a * b) + c
  Softfloat_mulAdd_subC    1 # (a * b) - c  (negate c)
  Softfloat_mulAdd_subProd 2 # -(a * b) + c (negate product)
}

function set_fp_flag {
  arguments
    FpFlag flag
  description {
    Add +flag+ to the sticky flags bits in CSR[fcsr]
  }
  body {
    if (flag == FpFlag::NX) {
      CSR[fcsr].NX = 1;
    } else if (flag == FpFlag::UF) {
      CSR[fcsr].UF = 1;
    } else if (flag == FpFlag::OF) {
      CSR[fcsr].OF = 1;
    } else if (flag == FpFlag::DZ) {
      CSR[fcsr].DZ = 1;
    } else if (flag == FpFlag::NV) {
      CSR[fcsr].NV = 1;
    }
  }
}

function rm_to_mode {
  returns RoundingMode
  arguments
    Bits<3> rm,       # rm field from an instruction encoding
    Bits<32> encoding # instruction encoding, needed to raise an exception
  description {
    Convert +rm+ to a RoundingMode.

    +encoding+ is the full encoding of the instruction +rm+ comes from.

    Will raise an IllegalInstruction exception if rm is a
    reserved encoding.
  }
  body {
    if (rm == $bits(RoundingMode::RNE)) {
      return RoundingMode::RNE;
    } else if (rm == $bits(RoundingMode::RTZ)) {
      return RoundingMode::RTZ;
    } else if (rm == $bits(RoundingMode::RDN)) {
      return RoundingMode::RDN;
    } else if (rm == $bits(RoundingMode::RUP)) {
      return RoundingMode::RUP;
    } else if (rm == $bits(RoundingMode::RMM)) {
      return RoundingMode::RMM;
    } else if (rm == $bits(RoundingMode::DYN)) {
      return $enum(RoundingMode, CSR[fcsr].FRM);
    } else {
      raise(ExceptionCode::IllegalInstruction, mode(), encoding);
    }
  }
}

function mark_f_state_dirty {
  description {
    Potentially updates `mstatus.FS` to the Dirty (3) state, depending on configuration settings.
  }
  body {
    if (HW_MSTATUS_FS_DIRTY_UPDATE== "precise") {
      CSR[mstatus].FS = 3; # set dirty state
    } else if (HW_MSTATUS_FS_DIRTY_UPDATE == "imprecise") {
      unpredictable("The hart may or may not update mstatus.FS now");
    }
  }
}

function nan_box {
  returns XReg
  arguments U32 FROM_SIZE, U32 TO_SIZE, XReg from_value
  description {
    Produces a properly NaN-boxed floating-point value from a floating-point value
    of smaller size by adding all 1's to the upper bits.
  }
  body {
    assert(FROM_SIZE < TO_SIZE, "Bad arguments; FROM_SIZE must be less than TO_SIZE");

    return {{TO_SIZE - FROM_SIZE{1'b1}}, from_value};
  }
}

function check_f_ok {
  arguments
    Bits<INSTR_ENC_SIZE> encoding
  description {
    Checks if instructions from the `F` extension can be executed, and, if not,
    raise an exception.
  }
  body {
    if (MUTABLE_MISA_F && CSR[misa].F == 0) {
      raise(ExceptionCode::IllegalInstruction, mode(), encoding);
    }

    if (CSR[mstatus].FS == 0) {
      raise(ExceptionCode::IllegalInstruction, mode(), encoding);
    }
  }
}

function is_sp_neg_inf? {
  returns Boolean
  arguments Bits<32> sp_value
  description {
    Return true if +sp_value+ is negative infinity.
  }
  body {
    return sp_value == SP_NEG_INF;
  }
}

function is_sp_pos_inf? {
  returns Boolean
  arguments Bits<32> sp_value
  description {
    Return true if +sp_value+ is positive infinity.
  }
  body {
    return sp_value == SP_POS_INF;
  }
}

function is_sp_neg_norm? {
  returns Boolean
  arguments Bits<32> sp_value
  description {
    Returns true if +sp_value+ is a negative normal number.
  }
  body {
    return
      (sp_value[31] == 1)                 # negative
      && (sp_value[30:23] != 0b11111111)  # not inf/NaN
      && (sp_value[30:23] != 0b00000000); # not zero or subnormal
  }
}

function is_sp_pos_norm? {
  returns Boolean
  arguments Bits<32> sp_value
  description {
    Returns true if +sp_value+ is a positive normal number.
  }
  body {
    return
      (sp_value[31] == 0)                 # positive
      && (sp_value[30:23] != 0b11111111)  # not inf/NaN
      && (sp_value[30:23] != 0b00000000); # not zero
  }
}

function is_sp_neg_subnorm? {
  returns Boolean
  arguments Bits<32> sp_value
  description {
    Returns true if +sp_value+ is a negative subnormal number.
  }
  body {
    return
      (sp_value[31] == 1)        # negative
      && (sp_value[30:23] == 0)  # subnormal exponent
      && (sp_value[22:0] != 0);  # not zero
  }
}

function is_sp_pos_subnorm? {
  returns Boolean
  arguments Bits<32> sp_value
  description {
    Returns true if +sp_value+ is a positive subnormal number.
  }
  body {
    return
      (sp_value[31] == 0)        # positive
      && (sp_value[30:23] == 0)  # subnormal exponent
      && (sp_value[22:0] != 0);  # not zero
  }
}

function is_sp_neg_zero? {
  returns Boolean
  arguments Bits<32> sp_value
  description {
    Returns true if +sp_value+ is negative zero.
  }
  body {
    return sp_value == SP_NEG_ZERO;
  }
}

function is_sp_pos_zero? {
  returns Boolean
  arguments Bits<32> sp_value
  description {
    Returns true if +sp_value+ is positive zero.
  }
  body {
    return sp_value == SP_POS_ZERO;
  }
}

function is_sp_nan? {
  returns Boolean
  arguments Bits<32> sp_value
  description {
    Returns true if +sp_value+ is a NaN (quiet or signaling)
  }
  body {
    return
      (sp_value[30:23] == 0b11111111)
      && (sp_value[22:0] != 0);    # signaling bit
  }
}

function is_sp_signaling_nan? {
  returns Boolean
  arguments Bits<32> sp_value
  description {
    Returns true if +sp_value+ is a signaling NaN
  }
  body {
    return
      (sp_value[30:23] == 0b11111111)
      && (sp_value[22] == 0)    # signaling bit
      && (sp_value[21:0] != 0); # not infinity
  }
}

function is_sp_quiet_nan? {
  returns Boolean
  arguments Bits<32> sp_value
  description {
    Returns true if +sp_value+ is a quiet NaN
  }
  body {
    return
      (sp_value[30:23] == 0b11111111)
      && (sp_value[22] == 1);    # signaling bit
  }
}

function softfloat_shiftRightJam32 {
  returns Bits<32>
  arguments
    Bits<32> a,
    Bits<32> dist
  description {
    Shifts +a+ right by the number of bits given in +dist+, which must not
    be zero.  If any nonzero bits are shifted off, they are "jammed" into the
    least-significant bit of the shifted value by setting the least-significant
    bit to 1.  This shifted-and-jammed value is returned.
    The value of +dist+ can be arbitrarily large.  In particular, if +dist+ is
    greater than 32, the result will be either 0 or 1, depending on whether +a+
    is zero or nonzero.
  }
  body {
    return (dist < 31) ? a>>dist | ((a[dist-1:0] != 0) ? 1 : 0) : ((a != 0) ? 1 : 0);
  }
}

function softfloat_shiftRightJam64 {
  returns Bits<64>
  arguments
    Bits<64> a,
    Bits<32> dist
  description {
     Shifts +a+ right by the number of bits given in +dist+, which must not
     be zero.  If any nonzero bits are shifted off, they are "jammed" into the
     least-significant bit of the shifted value by setting the least-significant
     bit to 1.  This shifted-and-jammed value is returned.

     The value of 'dist' can be arbitrarily large.  In particular, if +dist+ is
     greater than 64, the result will be either 0 or 1, depending on whether +a+
     is zero or nonzero.
  }
  body {
    return (dist < 63) ? a>>dist | ((a[dist-1:0] != 0) ? 1 : 0) : ((a != 0) ? 1 : 0);
  }
}

function softfloat_roundToI32 {
  returns Bits<32>
  arguments
    Bits<1> sign,
    Bits<64> sig,
    RoundingMode roundingMode
  description {
    Round to signed 32-bit integer, using +rounding_mode+
  }
  body {
    Bits<16> roundIncrement = 0x800;
    if (
      (roundingMode != RoundingMode::RMM)
      && (roundingMode != RoundingMode::RNE)
    ) {
      roundIncrement = 0;
      if (
        sign == 1
          ? (roundingMode == RoundingMode::RDN)
          : (roundingMode == RoundingMode::RUP)
      ) {
        roundIncrement = 0xFFF;
      }
    }
    Bits<16> roundBits = sig & 0xFFF;
    sig = sig + roundIncrement;
    if ((sig & 0xFFFFF00000000000) != 0) {
      set_fp_flag(FpFlag::NV);
      return sign == 1 ? WORD_NEG_OVERFLOW : WORD_POS_OVERFLOW;
    }

    Bits<32> sig32 = sig >> 12;
    if (
      (roundBits == 0x800 && (roundingMode == RoundingMode::RNE))
    ) {
      sig32 = sig32 & ~32'b1;
    }

    Bits<32> z = (sign == 1) ? -sig32 : sig32;
    if ((z != 0) && (($signed(z) < 's0) != (sign == 1))) {
      set_fp_flag(FpFlag::NV);
      return sign == 1 ? WORD_NEG_OVERFLOW : WORD_POS_OVERFLOW;
    }

    if (roundBits != 0) {
      set_fp_flag(FpFlag::NX);
    }
    return z;
  }
}

function f32_muladd {
  returns U32
  arguments
    U32 a,
    U32 b,
    U32 c,
    F32MulAddOp op,
    RoundingMode mode
  description {
    Fused multiply-add for single-precision floats.
    Computes (a * b) + c, with sign modifications based on op:
      Softfloat_mulAdd_addC:    (a * b) + c
      Softfloat_mulAdd_subC:    (a * b) - c  (negate c)
      Softfloat_mulAdd_subProd: -(a * b) + c (negate product)
    Translated from Berkeley Softfloat softfloat_mulAddF32.
  }
  body {
    if (is_sp_signaling_nan?(a) || is_sp_signaling_nan?(b) || is_sp_signaling_nan?(c)) {
      set_fp_flag(FpFlag::NV);
    }
    Bits<1>  signA    = signF32UI(a);
    Bits<16>  expA     = expF32UI(a);
    Bits<32> sigA     = fracF32UI(a);
    Bits<1>  signB    = signF32UI(b);
    Bits<16>  expB     = expF32UI(b);
    Bits<32> sigB     = fracF32UI(b);
    Bits<1>  signC    = signF32UI(c) ^ ((op == F32MulAddOp::Softfloat_mulAdd_subC) ? 1 : 0);
    Bits<16>  expC     = expF32UI(c);
    Bits<32> sigC     = fracF32UI(c);
    Bits<1>  signProd = (signA ^ signB) ^ ((op == F32MulAddOp::Softfloat_mulAdd_subProd) ? 1 : 0);

    Bits<32> magBits;
    Bits<64> sig64Z;

    # Handle NaN/Inf in A
    if (expA == 0xFF) {
      if ((sigA != 0) || ((expB == 0xFF) && (sigB != 0))) {
        return SP_CANONICAL_NAN;
      }
      magBits = expB | sigB;
      if (magBits != 0) {
        U32 zA = packToF32UI(signProd, 0xFF, 0);
        if (expC != 0xFF) {
          return zA;
        }
        if (sigC != 0) {
          return SP_CANONICAL_NAN;
        }
        if (signProd == signC) {
          return zA;
        }
      }
      set_fp_flag(FpFlag::NV);
      return SP_CANONICAL_NAN;
    }

    # Handle NaN/Inf in B
    if (expB == 0xFF) {
      if (sigB != 0) {
        return SP_CANONICAL_NAN;
      }
      magBits = expA | sigA;
      if (magBits != 0) {
        U32 zB = packToF32UI(signProd, 0xFF, 0);
        if (expC != 0xFF) {
          return zB;
        }
        if (sigC != 0) {
          return SP_CANONICAL_NAN;
        }
        if (signProd == signC) {
          return zB;
        }
      }
      set_fp_flag(FpFlag::NV);
      return SP_CANONICAL_NAN;
    }

    # Handle NaN/Inf in C
    if (expC == 0xFF) {
      if (sigC != 0) {
        return SP_CANONICAL_NAN;
      }
      return c;
    }

    # Handle zero/subnormal A
    if (expA == 0) {
      if (sigA == 0) {
        if (((expC | sigC) == 0) && (signProd != signC)) {
          return packToF32UI((mode == RoundingMode::RDN) ? 1 : 0, 0, 0);
        }
        return c;
      }
      ExpAndSig norm = softfloat_normSubnormalF32Sig(sigA);
      expA = norm.exp;
      sigA = norm.sig;
    }

    # Handle zero/subnormal B
    if (expB == 0) {
      if (sigB == 0) {
        if (((expC | sigC) == 0) && (signProd != signC)) {
          return packToF32UI((mode == RoundingMode::RDN) ? 1 : 0, 0, 0);
        }
        return c;
      }
      ExpAndSig norm = softfloat_normSubnormalF32Sig(sigB);
      expB = norm.exp;
      sigB = norm.sig;
    }

    # Compute product exponent and significand
    Bits<16> expProd = expA + expB - 16'h007E;
    sigA = (sigA | 32'h00800000) << 7;
    sigB = (sigB | 32'h00800000) << 7;
    U64 sigProd = sigA `* sigB;
    if (sigProd < 64'h2000000000000000) {
      expProd = expProd - 1;
      sigProd = sigProd << 1;
    }
    Bits<1>  signZ = signProd;
    Bits<16> expZ;
    Bits<32> sigZ;

    # Handle zero/subnormal C
    if (expC == 0) {
      if (sigC == 0) {
        expZ = expProd - 1;
        sigZ = softfloat_shiftRightJam64(sigProd, 31);
        return softfloat_roundPackToF32(signZ, expZ, sigZ, mode);
      }
      ExpAndSig norm = softfloat_normSubnormalF32Sig(sigC);
      expC = norm.exp;
      sigC = norm.sig;
    }
    sigC = (sigC | 0x00800000) << 6;

    Bits<16> expDiff = expProd - expC;

    if (signProd == signC) {
      # Same sign: add magnitudes
      if ($signed(expDiff) <= 0s) {
        expZ = expC;
        sigZ = sigC + softfloat_shiftRightJam64(sigProd, 32 - expDiff);
      } else {
        expZ = expProd;
        sig64Z = sigProd + softfloat_shiftRightJam64(sigC `<< 32, expDiff);
        sigZ = softfloat_shiftRightJam64(sig64Z, 32);
      }
      if (sigZ < 0x40000000) {
        expZ = expZ - 1;
        sigZ = sigZ << 1;
      }
      return softfloat_roundPackToF32(signZ, expZ, sigZ, mode);
    } else {
      # Different signs: subtract magnitudes
      U64 sig64C = sigC `<< 32;
      if ($signed(expDiff) < 0s) {
        signZ = signC;
        expZ = expC;
        sig64Z = sig64C - softfloat_shiftRightJam64(sigProd, -expDiff);
      } else if (expDiff == 0) {
        expZ = expProd;
        sig64Z = sigProd - sig64C;
        if (sig64Z == 0) {
          return packToF32UI((mode == RoundingMode::RDN) ? 1 : 0, 0, 0);
        }
        if ((sig64Z & 64'h8000000000000000) != 0) {
          signZ = signZ ^ 1;
          sig64Z = -sig64Z;
        }
      } else {
        expZ = expProd;
        sig64Z = sigProd - softfloat_shiftRightJam64(sig64C, expDiff);
      }
      Bits<8> shiftDist = count_leading_zeros_64(64, sig64Z) - 1;
      expZ = expZ - shiftDist;
      shiftDist = shiftDist - 8'h20;
      if ($signed(shiftDist) < 0s) {
        sigZ = softfloat_shiftRightJam64(sig64Z, -shiftDist);
      } else {
        sigZ = sig64Z << shiftDist;
      }
      return softfloat_roundPackToF32(signZ, expZ, sigZ, mode);
    }
  }
}

function f32_sqrt {
  returns U32
  arguments
    U32 a,
    RoundingMode mode
  description {
    Computes the square root of a 32-bit floating point number.
    Translated from Berkeley Softfloat f32_sqrt.
  }
  body {
    if (is_sp_signaling_nan?(a)) {
      set_fp_flag(FpFlag::NV);
    }
    Bits<1> signA = signF32UI(a);
    Bits<16> expA  = expF32UI(a);
    Bits<32> fracA = fracF32UI(a);

    if (expA == 8'hFF) {
      if (fracA != 0) { return SP_CANONICAL_NAN; }
      if (signA == 0) { return a; }
      set_fp_flag(FpFlag::NV);
      return SP_CANONICAL_NAN;
    }
    if (signA == 1) {
      if ((expA == 0) && (fracA == 0)) { return a; }
      set_fp_flag(FpFlag::NV);
      return SP_CANONICAL_NAN;
    }
    if (expA == 0) {
      if (fracA == 0) { return a; }
      ExpAndSig norm = softfloat_normSubnormalF32Sig(fracA);
      expA = norm.exp;
      fracA = norm.sig;
    }

    Bits<16> adjExp = expA - 16'h007F;
    Bits<16> expZ = ((adjExp >> 1) ^ (adjExp & 16'h8000)) + 16'h007E;
    Bits<1> oddExpA = expA[0];
    Bits<32> sigA32 = (fracA | 32'h00800000) << 8;
    Bits<32> sigZ = (sigA32 `* softfloat_approxRecipSqrt32_1(oddExpA, sigA32)) >> 32;
    if (oddExpA == 1) {
      sigZ = sigZ >> 1;
    }
    sigZ = sigZ + 2;

    if ((sigZ & 0x3F) < 2) {
      Bits<32> shiftedSigZ = sigZ >> 2;
      Bits<32> negRem = shiftedSigZ * shiftedSigZ;
      sigZ = sigZ & ~32'h3;
      if ((negRem & 0x80000000) != 0) {
        sigZ = sigZ | 1;
      } else {
        if (negRem != 0) { sigZ = sigZ - 1; }
      }
    }

    return softfloat_roundPackToF32(0, expZ, sigZ, mode);
  }
}

# Lookup tables for reciprocal and reciprocal-sqrt approximation (Berkeley Softfloat)
Bits<16> softfloat_approxRecip_1k0s[16] = [
  0xFFC4, 0xF0BE, 0xE363, 0xD76F, 0xCCAD, 0xC2F0, 0xBA16, 0xB201,
  0xAA97, 0xA3C1, 0x9D49, 0x9715, 0x9128, 0x8B7C, 0x8600, 0x80B6
];
Bits<16> softfloat_approxRecip_1k1s[16] = [
  0xF0F1, 0xD62C, 0xBFA1, 0xAC77, 0x9C0A, 0x8DDE, 0x8185, 0x7709,
  0x6E7D, 0x6794, 0x6188, 0x5C71, 0x5764, 0x52BE, 0x4E55, 0x4A67
];
Bits<16> softfloat_approxRecipSqrt_1k0s[16] = [
  0xB4C9, 0xFFAB, 0xAA7D, 0xF11C, 0xA1C5, 0xE4C7, 0x9A43, 0xDA29,
  0x93B5, 0xD0E5, 0x8DED, 0xC8B7, 0x88C6, 0xC16D, 0x8424, 0xBAE1
];
Bits<16> softfloat_approxRecipSqrt_1k1s[16] = [
  0xA5A5, 0xEA42, 0x8C21, 0xC62D, 0x788F, 0xAA7F, 0x6928, 0x94B6,
  0x5CC7, 0x8335, 0x52A6, 0x74EA, 0x4A3E, 0x68C8, 0x42BC, 0x5EFF
];

function softfloat_approxRecip32_1 {
  returns U32
  arguments
    Bits<32> a
  description {
    Returns floor(0x7FFFFFFFFFFFFFFF / a), matching the platform-specific
    Berkeley SoftFloat macro on 64-bit hosts. Computed via binary long division.
  }
  body {
    Bits<64> a64 = {32'h0, a};
    Bits<64> a_top = a64 << 31;
    Bits<64> rem = 64'h7FFFFFFFFFFFFFFF;
    Bits<32> q = 0;
    for (U32 i = 0; i < 32; i++) {
      Bits<64> d = a_top >> i;
      if (rem >= d) {
        q = q | (32'h1 << (31 - i));
        rem = rem - d;
      }
    }
    return q;
  }
}

function softfloat_approxRecipSqrt32_1 {
  returns U32
  arguments
    Bits<1> oddExpA,
    Bits<32> a
  description {
    Returns a 32-bit approximation of 1/sqrt(a).
    Translated from Berkeley Softfloat softfloat_approxRecipSqrt32_1.
  }
  body {
    Bits<8> index = ((a >> 27) & 0xE) + oddExpA;
    Bits<16> eps = a >> 12;
    Bits<16> r0 = softfloat_approxRecipSqrt_1k0s[index]
                  - ((softfloat_approxRecipSqrt_1k1s[index] `* eps) >> 20);
    Bits<32> eSqrR0 = r0 `* r0;
    if (oddExpA == 0) {
      eSqrR0 = eSqrR0 << 1;
    }
    Bits<32> sigma0 = ~((eSqrR0 `* a) >> 23);
    Bits<32> r = (r0 `<< 16) + ((r0 `* sigma0) >> 25);
    Bits<32> sqrSigma0 = (sigma0 `* sigma0) >> 32;
    Bits<32> adj = ((r >> 1) + (r >> 3) - (r0 `<< 14));
    r = r + ((adj `* sqrSigma0) >> 48);
    if ((r & 32'h80000000) == 0) {
      r = 32'h80000000;
    }
    return r;
  }
}

function f32_div {
  returns U32
  arguments
    U32 a,
    U32 b,
    RoundingMode mode
  description {
    Divides two 32-bit floating point numbers.
    Translated from Berkeley Softfloat f32_div.
  }
  body {
    if (is_sp_signaling_nan?(a) || is_sp_signaling_nan?(b)) {
      set_fp_flag(FpFlag::NV);
    }
    Bits<1> signA = signF32UI(a);
    Bits<16> expA  = expF32UI(a);
    Bits<32> sigA = fracF32UI(a);
    Bits<1> signB = signF32UI(b);
    Bits<16> expB  = expF32UI(b);
    Bits<32> sigB = fracF32UI(b);
    Bits<1> signZ = signA ^ signB;

    Bits<16> expZ;

    if (expA == 8'hFF) {
      if (sigA != 0) { return SP_CANONICAL_NAN; }
      if (expB == 8'hFF) {
        if (sigB != 0) { return SP_CANONICAL_NAN; }
        set_fp_flag(FpFlag::NV);
        return SP_CANONICAL_NAN;
      }
      return packToF32UI(signZ, 8'hFF, 0);
    }
    if (expB == 8'hFF) {
      if (sigB != 0) { return SP_CANONICAL_NAN; }
      return packToF32UI(signZ, 0, 0);
    }

    if (expB == 0) {
      if (sigB == 0) {
        if ((expA == 0) && (sigA == 0)) {
          set_fp_flag(FpFlag::NV);
          return SP_CANONICAL_NAN;
        }
        set_fp_flag(FpFlag::DZ);
        return packToF32UI(signZ, 8'hFF, 0);
      }
      ExpAndSig norm = softfloat_normSubnormalF32Sig(sigB);
      expB = norm.exp;
      sigB = norm.sig;
    }

    if (expA == 0) {
      if (sigA == 0) { return packToF32UI(signZ, 0, 0); }
      ExpAndSig norm = softfloat_normSubnormalF32Sig(sigA);
      expA = norm.exp;
      sigA = norm.sig;
    }

    expZ = expA - expB + 16'h007E;
    sigA = sigA | 32'h00800000;
    sigB = sigB | 32'h00800000;

    if (sigA < sigB) {
      expZ = expZ - 1;
      sigA = sigA << 8;
    } else {
      sigA = sigA << 7;
    }
    sigB = sigB << 8;

    Bits<32> recip32 = softfloat_approxRecip32_1(sigB);
    Bits<32> sigZ = (sigA `* recip32) >> 32;
    sigZ = sigZ + 2;

    if ((sigZ & 7) <= 2) {
      sigZ = sigZ & ~32'h3;
      Bits<64> rem = (sigA `<< 31) - (sigZ `* sigB);
      if ((rem & 64'h8000000000000000) != 0) {
        sigZ = sigZ - 4;
      } else {
        if ( rem != 0 ) {
          sigZ = sigZ | 1;
        }
      }
    }

    return softfloat_roundPackToF32(signZ, expZ, sigZ, mode);
  }
}

function f32_mul {
  returns U32
  arguments
    U32 a,
    U32 b,
    RoundingMode mode
  description {
    Multiplies two 32-bit floating point numbers.
    Translated from Berkeley Softfloat f32_mul.
  }
  body {
    if (is_sp_signaling_nan?(a) || is_sp_signaling_nan?(b)) {
      set_fp_flag(FpFlag::NV);
    }
    Bits<1> signA = signF32UI(a);
    Bits<16> expA  = expF32UI(a);
    Bits<23> fracA = fracF32UI(a);
    Bits<1> signB = signF32UI(b);
    Bits<16> expB  = expF32UI(b);
    Bits<23> fracB = fracF32UI(b);
    Bits<1> signZ = signA ^ signB;

    Bits<32> sigA = fracA;
    Bits<32> sigB = fracB;
    Bits<16> expZ;
    Bits<32> sigZ;

    if (expA == 8'hFF) {
      if ((fracA != 0) || ((expB == 8'hFF) && (fracB != 0))) {
        return SP_CANONICAL_NAN;
      }
      if ((expB == 0) && (fracB == 0)) {
        set_fp_flag(FpFlag::NV);
        return SP_CANONICAL_NAN;
      }
      return packToF32UI(signZ, 8'hFF, 0);
    }
    if (expB == 8'hFF) {
      if (fracB != 0) {
        return SP_CANONICAL_NAN;
      }
      if ((expA == 0) && (fracA == 0)) {
        set_fp_flag(FpFlag::NV);
        return SP_CANONICAL_NAN;
      }
      return packToF32UI(signZ, 8'hFF, 0);
    }

    if (expA == 0) {
      if (fracA == 0) { return packToF32UI(signZ, 0, 0); }
      ExpAndSig norm = softfloat_normSubnormalF32Sig(fracA);
      expA = norm.exp;
      sigA = norm.sig;
    }

    if (expB == 0) {
      if (fracB == 0) { return packToF32UI(signZ, 0, 0); }
      ExpAndSig norm = softfloat_normSubnormalF32Sig(fracB);
      expB = norm.exp;
      sigB = norm.sig;
    }

    expZ = expA + expB - 16'h007F;
    sigA = (sigA | 32'h00800000)<<7;
    sigB = (sigB | 32'h00800000)<<8;
    sigZ = softfloat_shiftRightJam64(sigA `* sigB, 32);
    if (sigZ < 0x40000000 ) {
      expZ = expZ - 1;
      sigZ = sigZ << 1;
    }

    return softfloat_roundPackToF32(signZ, expZ, sigZ, mode);
  }
}

function f32_to_i64 {
  returns Bits<64>
  arguments
    U32 a,
    RoundingMode mode
  description {
    Converts 32-bit floating point number to a signed 64-bit integer.
    Translated from Berkeley Softfloat f32_to_i64.
  }
  body {
    Bits<1> sign = signF32UI(a);
    Bits<16> exp  = expF32UI(a);
    Bits<32> sig = fracF32UI(a);

    Bits<16> shiftDist = 16'hBE - exp;
    Bits<64> sig64;
    Bits<64> extra;

    if ($signed(shiftDist) < 0s) {
      set_fp_flag(FpFlag::NV);
      if ((exp == 16'hFF) && (sig != 0)) {
        return I64_NAN;
      } else {
        return (sign == 1) ? I64_NEG_OVERFLOW : I64_POS_OVERFLOW;
      }
    }

    if (exp != 0) {
      sig = sig | 32'h00800000;
    }

    sig64 = sig `<< 40;
    extra = 0;
    if (shiftDist != 0) {
      TwoU64s sig64Extra = softfloat_shiftRightJam64Extra( sig64, 0, $signed(shiftDist) );
      sig64 = sig64Extra.u1;
      extra = sig64Extra.u2;
    }
    return softfloat_roundToI64( sign, sig64, extra, mode );
  }
}

struct TwoU64s {
  Bits<64> u1;
  Bits<64> u2;
}

function softfloat_shiftRightJam64Extra {
  returns TwoU64s
  arguments
    Bits<64> a,
    Bits<64> extra,
    Bits<32> dist
  description {
    Shifts the 128 bits formed by concatenating 'a' and 'extra' right by 64
    _plus_ the number of bits given in 'dist', which must not be zero.  This
    shifted value is at most 64 nonzero bits and is returned in the 'v' field
    of the 'struct uint64_extra' result.  The 64-bit 'extra' field of the result
    contains a value formed as follows from the bits that were shifted off:  The
    _last_ bit shifted off is the most-significant bit of the 'extra' field, and
    the other 63 bits of the 'extra' field are all zero if and only if _all_but_
    _the_last_ bits shifted off were all zero.
      (This function makes more sense if 'a' and 'extra' are considered to form
    an unsigned fixed-point number with binary point between 'a' and 'extra'.
    This fixed-point value is shifted right by the number of bits given in
    'dist', and the integer part of this shifted value is returned in the 'v'
    field of the result.  The fractional part of the shifted value is modified
    as described above and returned in the 'extra' field of the result.)
  }
  body {
    TwoU64s z;

    if (dist < 64) {
      z.u1 = a >> dist;
      z.u2 = a << (-dist & 63);
    } else {
      z.u1 = 0;
      z.u2 = (dist == 64) ? a : ((a != 0) ? 1 : 0);
    }
    z.u2 = z.u2 | ((extra != 0) ? 1 : 0);

    return z;
  }
}

function f32_to_ui64 {
  returns Bits<64>
  arguments
    U32 a,
    RoundingMode mode
  description {
    Converts 32-bit floating point number to an unsigned 64-bit integer.
    Translated from Berkeley Softfloat f32_to_ui64.
  }
  body {
    Bits<1> sign = signF32UI(a);
    Bits<16> exp  = expF32UI(a);
    Bits<32> sig = fracF32UI(a);

    Bits<16> shiftDist;
    Bits<64> sig64, extra;

    # shiftDist = 0xBE - exp  (0xBE = 190 = 127 + 63)
    shiftDist = 16'hBE - exp;

    if ($signed(shiftDist) < 0s) {
      set_fp_flag(FpFlag::NV);
      if ((exp == 0xFF) && (sig != 0)) {
        return UI64_NAN;
      } else if (sign != 0) {
        return UI64_NEG_OVERFLOW;
      } else {
        return UI64_POS_OVERFLOW;
      }
    }

    if (exp != 0) {
      sig = sig | 32'h00800000;
    }
    sig64 = sig `<< 40;
    extra = 0;
    if (shiftDist != 0) {
      TwoU64s sig64Extra = softfloat_shiftRightJam64Extra(sig64, 0, $signed(shiftDist));
      sig64 = sig64Extra.u1;
      extra = sig64Extra.u2;
    }
    return softfloat_roundToUI64( sign, sig64, extra, mode );
  }
}

function i64_to_f32 {
  returns U32
  arguments
    Bits<64> a,
    RoundingMode mode
  description {
    Converts 64-bit signed integer to 32-bit floating point number.
    Translated from Berkeley Softfloat i64_to_f32.
  }
  body {
    Bits<1> sign = a[63];
    Bits<64> absA;

    if (sign == 1) {
      absA = -a;
    } else {
      absA = a;
    }

    # count_leading_zeros<64> returns the number of leading zeros
    Bits<8> shiftDist = count_leading_zeros(64, absA) - 40;
    Bits<32> sig;

    if ($signed(shiftDist) >= 0s) {
      if (a != 0) {
        return packToF32UI(sign, 16'h95 - shiftDist, absA << shiftDist);
      } else {
        return 0;
      }
    } else {
      shiftDist = shiftDist + 7;
      if ($signed(shiftDist) < 0s) {
        sig = softfloat_shortShiftRightJam64( absA, -shiftDist );
      } else {
        sig = absA << shiftDist;
      }
      return softfloat_roundPackToF32(sign, 8'h9C - shiftDist, sig, mode);
    }
  }
}

function ui64_to_f32 {
  returns U32
  arguments
    Bits<64> a,
    RoundingMode mode
  description {
    Converts 64-bit unsigned integer to 32-bit floating point number.
    Translated from Berkeley Softfloat ui64_to_f32.
  }
  body {
    Bits<8> shiftDist = count_leading_zeros(64, a) - 40;
    Bits<32> sig;

    if (0s <= $signed(shiftDist)) {
      if (a != 0) {
        return packToF32UI(0, 8'h95 - shiftDist, a << shiftDist);
      } else {
        return 0;
      }
    } else {
      shiftDist = shiftDist + 7;
      if ($signed(shiftDist) < 0s) {
        sig = softfloat_shortShiftRightJam64(a, -shiftDist);
      } else {
        sig = a << shiftDist;
      }
      return softfloat_roundPackToF32(0, 8'h9C - shiftDist, sig, mode);
    }
  }
}

function softfloat_roundToUI32 {
  returns Bits<32>
  arguments
    Bits<1> sign,
    Bits<64> sig,
    RoundingMode roundingMode
  description {
    Round to unsigned 32-bit integer, using +rounding_mode+
  }
  body {
    Bits<16> roundIncrement = 0x800;
    if (
      (roundingMode != RoundingMode::RMM)
      && (roundingMode != RoundingMode::RNE)
    ) {
      roundIncrement = 0;
      if ( sign == 1) {
        if (sig == 0) { return 0; }
        if (roundingMode == RoundingMode::RDN) { set_fp_flag(FpFlag::NV); }
      } else {
        if (roundingMode == RoundingMode::RUP) { roundIncrement = 0xFFF; }
      }
    }

    Bits<16> roundBits = sig & 0xFFF;
    sig = sig + roundIncrement;
    if ((sig & 0xFFFFF00000000000) != 0) {
      set_fp_flag(FpFlag::NV);
      return sign == 1 ? UI32_NEG_OVERFLOW : UI32_POS_OVERFLOW;
    }

    Bits<32> z = sig >> 12;
    if (
      (roundBits == 0x800 && (roundingMode == RoundingMode::RNE))
    ) {
      z = z & ~32'b1;
    }

    if ((z != 0) && (sign == 1)) {
      set_fp_flag(FpFlag::NV);
      return sign == 1 ? UI32_NEG_OVERFLOW : UI32_POS_OVERFLOW;
    }

    if (roundBits != 0) {
      set_fp_flag(FpFlag::NX);
    }
    return z;
  }
}

function packToF32UI {
  returns Bits<32>
  arguments
    Bits<1> sign,
    Bits<8> exp,
    Bits<32> sig
  description {
    Pack components into a 32-bit value
  }
  body {
    return (sign `<< 31) + (exp `<< 23) + sig;
  }
}

function packToF16UI {
  returns Bits<32>
  arguments
    Bits<1> sign,
    Bits<5> exp,
    Bits<10> sig
  description {
    Pack components into a 16-bit value
  }
  body {
    return {sign, exp, sig};
  }
}

function softfloat_normSubnormalF16Sig {
  returns Bits<5>, Bits<10>
  arguments
    Bits<16> hp_value
  description {
    normalize subnormal half-precision value
  }
  body {
    Bits<8> shift_dist = count_leading_zeros(16, hp_value);
    return 1 - shift_dist, hp_value << shift_dist;
  }
}

function softfloat_roundPackToF32 {
  returns Bits<32>     # single precision value
  arguments
    Bits<1> sign,
    Bits<16> exp,
    Bits<32> sig,
    RoundingMode mode
  description {
    Round FP value according to +mdode+ and then pack it in IEEE format.
  }
  body {
    Bits<8> roundIncrement = 0x40;
    if ( (mode != RoundingMode::RNE) && (mode != RoundingMode::RMM)) {
      roundIncrement =
        (mode == ((sign != 0) ? RoundingMode::RDN : RoundingMode::RUP))
          ? 0x7F
          : 0;
    }
    Bits<8> roundBits = sig & 0x7f;

    if ( 0xFD <= exp ) {
      if ($signed(exp) < 's0) {
        Boolean isTiny =
          ($signed(exp) < -8's1) || (sig + roundIncrement < 0x80000000);
        sig = softfloat_shiftRightJam32( sig, -exp );
        exp = 0;
        roundBits = sig & 0x7F;
        if (isTiny && (roundBits != 0)) {
          set_fp_flag(FpFlag::UF);
        }
      } else if ('shFD < $signed(exp) || (0x80000000 <= sig + roundIncrement)) {
        set_fp_flag(FpFlag::OF);
        set_fp_flag(FpFlag::NX);
        return packToF32UI(sign, 0xFF, 0) - ((roundIncrement == 0) ? 1 : 0);
      }
    }

    sig = (sig + roundIncrement) >> 7;
    if (roundBits != 0) {
      set_fp_flag(FpFlag::NX);
    }
    if ((roundBits == 0x40) && (mode == RoundingMode::RNE)) {
      sig = sig & ~32'b1;  # Clear only the LSB
    }
    # sig = sig & ~((((roundBits ^ 0x40) == 0) ? 32'0 : 32'1) & ((mode == RoundingMode::RNE) ? 32'1 : 32'0));
    if ( sig == 0 ) {
      exp = 0;
    }
    return packToF32UI(sign, exp, sig);
  }
}

function softfloat_normRoundPackToF32 {
  returns Bits<32>
  arguments
    Bits<1> sign,
    Bits<16> exp,
    Bits<32> sig,
    RoundingMode mode
  description {
    Normalize, round, and pack into a 32-bit floating point value
  }
  body {
    Bits<8> shiftDist = count_leading_zeros(32, sig) - 1;
    exp = exp - shiftDist;
    if ((7 <= shiftDist) && (exp < 0xFD)) {
      return packToF32UI(sign, (sig != 0) ? exp : 0, sig << (shiftDist - 7));
    } else {
      return softfloat_roundPackToF32(sign, exp, sig << shiftDist, mode);
    }
  }
}

function signF32UI {
  returns Bits<1>
  arguments
    Bits<32> a
  description {
    Extract sign-bit of a 32-bit floating point number
  }
  body {
    return a[31];
  }
}

function expF32UI {
  returns Bits<8>
  arguments
    Bits<32> a
  description {
    Extract exponent of a 32-bit floating point number
  }
  body {
    return a[30:23];
  }
}

function fracF32UI {
  returns Bits<23>
  arguments
    Bits<32> a
  description {
    Extract significand of a 32-bit floating point number
  }
  body {
    return a[22:0];
  }
}

function returnNonSignalingNaN {
  returns U32
  arguments
    U32 a
  description {
    Returns a non-signalling NaN version of the floating-point number
    Does not modify the input
  }
  body {
    U32 a_copy = a;
    a_copy[22] = 1'b1;
    return a_copy;
  }
}

function returnMag {
  returns U32
  arguments
    U32 a
  description {
    Returns magnitude of the given number
    Does not modify the input
  }
  body {
    U32 a_copy = a;
    # make sign bit zero
    a_copy[31] = 1'b0;
    return a_copy;
  }
}

function returnLargerMag {
  returns U32
  arguments
    U32 a,
    U32 b
  description {
    Returns the larger number between a and b by magnitude
    If either number is signaling NaN then that is made quiet
  }
  body {
    U32 mag_a = returnMag(a);
    U32 mag_b = returnMag(b);
    U32 nonsig_a = returnNonSignalingNaN(a);
    U32 nonsig_b = returnNonSignalingNaN(b);
    if (mag_a < mag_b) {
      return nonsig_b;
    }
    if (mag_b < mag_a) {
      return nonsig_a;
    }
    return (nonsig_a < nonsig_b) ? nonsig_a : nonsig_b;
  }
}

function softfloat_addMagsF32 {
  returns U32
  arguments
    U32 a,
    U32 b,
    RoundingMode mode
  description {
    Returns sum of the magnitudes of 2 floating point numbers
  }
  body {
    if (is_sp_signaling_nan?(a) || is_sp_signaling_nan?(b)) {
      set_fp_flag(FpFlag::NV);
    }

    # extract exponents and significands of a and b
    Bits<16> expA = expF32UI(a);
    Bits<32> sigA = fracF32UI(a);
    Bits<16> expB = expF32UI(b);
    Bits<32> sigB = fracF32UI(b);

    # declare a variable to store significand of sum
    U32 sigZ;
    # declare a variable to store sum of the magnitudes of the 2 numbers
    U32 z;
    # declare a variable to store sign of sum
    Bits<1> signZ;

    # declare a variable to store the exponent part of sum
    Bits<8> expZ;

    # calculate difference of exponents
    Bits<16> expDiff = expA - expB;

    if (expDiff == 16'd0) {
      if (expA == 8'd0) {
        z = a + b;
        return z; # if exponents of both numbers are zero, then return sum of both numbers
      }

      # check if A is infinity or NaN
      if (expA == 8'hFF) {
        # A is NaN if significand is non-zero and exponent is 8'hFF
        if ((sigA != 8'd0) || (sigB != 8'd0)) {
          return SP_CANONICAL_NAN;
        }
        # return infinity if A is infinity
        return a;
      }

      signZ = signF32UI(a);
      expZ = expA;
      sigZ = 32'h01000000 + sigA + sigB;

      # check if significand is even and exponent is less than 8'FE
      if (((sigZ & 0x1) == 0) && (expZ < 8'hFE)) {
        # if significand is even, remove trailing zero
        sigZ = sigZ >> 1;
        # pack the sign, exponent and significand
        return (32'h0 + (signZ << 31) + (expZ << 23) + sigZ);
      }

      sigZ = sigZ << 6;
    } else {

      signZ = signF32UI(a);

      sigA = sigA << 6;
      sigB = sigB << 6;

      # check if B has a bigger exponent value than A
      if ($signed(expDiff) < 0s) {
        # check if B is infinity or NaN
        if (expB == 8'hFF) {
          # B is NaN if exponent is 8'hFF and significand is non-zero
          if (sigB != 0) {
            return SP_CANONICAL_NAN;
          }
          # return infinity with same sign as A
          return packToF32UI(signZ, 8'hFF, 23'h0);
        }
        expZ  = expB;

        sigA = (expA == 0) ? 2*sigA : (sigA + 0x20000000);
        sigA = softfloat_shiftRightJam32(sigA, -expDiff);
      } else {
        # check if A is infinity or NaN
        if (expA == 8'hFF) {
          # A is NaN if exponent is 8'hFF and significand is non-zero
          if (sigA != 0) {
            return SP_CANONICAL_NAN;
          }
            # return infinity with same sign as A
            return a;
        }

        expZ = expA;
        sigB = (expB == 0) ? 2*sigB : (sigB + 0x20000000);
        sigB = softfloat_shiftRightJam32(sigB, expDiff);
      }

      sigZ = 0x20000000 + sigA + sigB;
      if ( sigZ < 0x40000000 ) {
            expZ = expZ - 1;
            sigZ =  sigZ << 1;
        }
    }
    return softfloat_roundPackToF32(signZ, expZ, sigZ, mode);
  }
}

function softfloat_subMagsF32 {
  returns U32
  arguments
    U32 a,
    U32 b,
    RoundingMode mode
  description {
    Returns difference of the magnitudes of 2 floating point numbers
  }
  body {
    if (is_sp_signaling_nan?(a) || is_sp_signaling_nan?(b)) {
      set_fp_flag(FpFlag::NV);
    }

    # extract exponents and significands of a and b
    Bits<16> expA = expF32UI(a);
    Bits<32> sigA = fracF32UI(a);
    Bits<16> expB = expF32UI(b);
    Bits<32> sigB = fracF32UI(b);

    # declare a variable to store significand of difference
    U32 sigZ;
    # declare a variable to store difference of the magnitudes of the 2 numbers
    U32 z;
    # declare a variable to store sign of difference
    Bits<1> signZ;

    # declare a variable to store the exponent part of difference
    Bits<8> expZ;

    # declare a variable to store the difference in significand
    U32 sigDiff;

    # declare a sigX and sigY
    U32 sigX;
    U32 sigY;

    # declare a variable to store shift distance
    Bits<8> shiftDist;

    # calculate difference of exponents
    Bits<16> expDiff = expA - expB;

    if (expDiff == 16'd0) {

      # check if A is infinity or NaN
      if (expA == 8'hFF) {
        set_fp_flag(FpFlag::NV);
        return SP_CANONICAL_NAN;
      }

      sigDiff = sigA - sigB;

      # check if no difference in significand
      if (sigDiff == 0) {
        # return -0 if rounding mode is round down, else return +0
        return packToF32UI(((mode == RoundingMode::RDN) ? 1 : 0),0,0);
      }

      if (expA != 0) {
        expA = expA - 1;
      }

      signZ = signF32UI(a);

      # if difference is negative, change the sign of the result
      if (sigDiff < 0) {
        signZ = ~signZ;
        sigDiff = -32'sh1 * sigDiff;
      }

      shiftDist = count_leading_zeros(32, sigDiff) - 8;
      expZ = expA - shiftDist;

      if (expZ < 0) {
        shiftDist = expA;
        expZ       = 0;
      }

      return packToF32UI(signZ, expZ, sigDiff << shiftDist);

    } else {
      # when difference in exponents are not zero
      signZ = signF32UI(a);
      sigA = sigA << 7;
      sigB = sigB << 7;
      if ($signed(expDiff) < 0s) {
        signZ = ~signZ;
        if (expB == 0xFF) {
          if (sigB != 0) {
            return SP_CANONICAL_NAN;
          }
          return packToF32UI(signZ, expB, 0);
        }
        expZ = expB - 1;
        sigX = sigB | 0x40000000;
        sigY = sigA + ((expA != 0) ? 0x40000000 : sigA);
        expDiff = - expDiff;
      } else {
        if (expA == 0xFF) {
          if (sigA != 0) {
            return SP_CANONICAL_NAN;
          }
          return a;
        }
        expZ = expA - 1;
        sigX = sigA | 0x40000000;
        sigY = sigB + ((expB != 0) ? 0x40000000 : sigB);
      }
      return softfloat_normRoundPackToF32(signZ, expZ, sigX - softfloat_shiftRightJam32(sigY, expDiff), mode);
    }
  }
}

function f32_add {
  returns U32
  arguments
    U32 a,
    U32 b,
    RoundingMode mode
  description {
    Returns sum of 2 floating point numbers
  }
  body {
    U32 a_xor_b = a ^ b;
    if (signF32UI(a_xor_b) == 1) {
      # subtract if signs are different
      return softfloat_subMagsF32(a,b,mode);
    } else {
      # add if signs are the same
      return softfloat_addMagsF32(a,b,mode);
    }
  }
}

function f32_sub {
  returns U32
  arguments
    U32 a,
    U32 b,
    RoundingMode mode
  description {
    Returns difference of 2 floating point numbers
  }
  body {
    U32 a_xor_b = a ^ b;
    if (signF32UI(a_xor_b) == 1) {
      # add if signs are different
      return softfloat_addMagsF32(a,b,mode);
    } else {
      # subtract if signs are the same
      return softfloat_subMagsF32(a,b,mode);
    }
  }
}

function i32_to_f32 {
  returns U32
  arguments
    U32 a,
    RoundingMode mode
  description {
    Converts 32-bit signed integer to 32-bit floating point number
  }
  body {
    # sign of integer, it is 1 when negative
    Bits<1> sign = a[31];
    if ((a & 0x7FFFFFFF) == 0) {
      return (sign == 1) ? packToF32UI(1, 0x9E, 0) : packToF32UI(0, 0, 0);
    }
    U32 absA = (sign == 1) ? -a : a;
    return softfloat_normRoundPackToF32(sign, 0x9C, absA, mode);
  }
}

function ui32_to_f32 {
  returns U32
  arguments
    U32 a,
    RoundingMode mode
  description {
    Converts 32-bit unsigned integer to 32-bit floating point number
  }
  body {
    # sign of integer, it is 1 when negative
    if (a == 0) {
      return a;
    }
    if (a[31] == 1) {
      return softfloat_roundPackToF32(0, 0x9D, a>>1 | (a & 1), mode);
    } else {
      return softfloat_normRoundPackToF32(0, 0x9C, a, mode);
    }
  }
}

function f32_to_i32 {
  returns U32
  arguments
    U32 a,
    RoundingMode mode
  description {
    Converts 32-bit floating point number to a signed 32-bit integer
  }
  body {
    Bits<1> sign = signF32UI(a);
    Bits<16> exp  = expF32UI(a);
    Bits<32> sig = fracF32UI(a);
    Bits<16> shiftDist;
    U64 sig64;
    # for NaN return the highest positive value and set floating-point flag to invalid.
    if ((exp == 8'hFF) && (sig != 0)) {
      sign = 0;
      set_fp_flag(FpFlag::NV);
      return I32_NAN;
    }

    # MSB of significand is set to 1 because minimum 32-bit integer in IEEE 754 is 32'h80000000
    if (exp != 0) {
      sig = sig | 32'h00800000;
    }

    sig64 = sig `<< 32;
    shiftDist = 8'hAA - exp;

    if ($signed(shiftDist) > 0s) {
      sig64 = softfloat_shiftRightJam64( sig64, shiftDist);
    }

    return softfloat_roundToI32(sign, sig64, mode);
  }
}

function f32_to_ui32 {
  returns U32
  arguments
    U32 a,
    RoundingMode mode
  description {
    Converts 32-bit floating point number to an unsigned 32-bit integer
  }
  body {
    Bits<1> sign = signF32UI(a);
    Bits<16> exp  = expF32UI(a);
    Bits<32> sig = fracF32UI(a);
    Bits<16> shiftDist;
    U64 sig64;
    # for NaN return the highest positive value and set floating-point flag to invalid.
    if ((exp == 8'hFF) && (sig != 0)) {
      sign = 0;
      set_fp_flag(FpFlag::NV);
      return UI32_NAN;
    }

    # MSB of significand is set to 1 because minimum 32-bit integer in IEEE 754 is 32'h80000000
    if (exp != 0) {
      sig = sig | 32'h00800000;
    }

    sig64 = sig `<< 32;
    shiftDist = 8'hAA - exp;

    if ($signed(shiftDist) > 0s) {
      sig64 = softfloat_shiftRightJam64( sig64, shiftDist);
    }

    return softfloat_roundToUI32(sign, sig64, mode);
  }
}

function softfloat_roundPackToF32_no_flag {
  returns Bits<32>     # single precision value
  arguments
    Bits<1> sign,
    Bits<16> exp,
    Bits<32> sig,
    RoundingMode mode
  description {
    Round FP value according to +mdode+ and then pack it in IEEE format.
    No flags to be set
  }
  body {
    Bits<8> roundIncrement = 0x40;
    if ( (mode != RoundingMode::RNE) && (mode != RoundingMode::RMM)) {
      roundIncrement =
        (mode == ((sign != 0) ? RoundingMode::RDN : RoundingMode::RUP))
          ? 0x7F
          : 0;
    }
    Bits<8> roundBits = sig & 0x7f;

    if ( 0xFD <= exp ) {
      if ($signed(exp) < 's0) {
        Boolean isTiny =
          ($signed(exp) < -8's1) || (sig + roundIncrement < 0x80000000);
        sig = softfloat_shiftRightJam32( sig, -exp );
        exp = 0;
        roundBits = sig & 0x7F;
      } else if ('shFD < $signed(exp) || (0x80000000 <= sig + roundIncrement)) {
        return packToF32UI(sign, 0xFF, 0) - ((roundIncrement == 0) ? 1 : 0);
      }
    }

    sig = (sig + roundIncrement) >> 7;
    sig = sig & ~((roundBits ^ 0x40) & ((mode == RoundingMode::RNE) ? 1 : 0));
    if ( sig == 0 ) {
      exp = 0;
    }
    return packToF32UI(sign, exp, sig);
  }
}

function softfloat_normRoundPackToF32_no_flag {
  returns Bits<32>
  arguments
    Bits<1> sign,
    Bits<16> exp,
    Bits<32> sig,
    RoundingMode mode
  description {
    Normalize, round, and pack into a 32-bit floating point value
    No flags to be set
  }
  body {
    Bits<8> shiftDist = count_leading_zeros(32, sig) - 1;
    exp = exp - shiftDist;
    if ((7 <= shiftDist) && (exp < 0xFD)) {
      return packToF32UI(sign, (sig != 0) ? exp : 0, sig << (shiftDist - 7));
    } else {
      return softfloat_roundPackToF32_no_flag(sign, exp, sig << shiftDist, mode);
    }
  }
}

function i32_to_f32_no_flag {
  returns U32
  arguments
    U32 a,
    RoundingMode mode
  description {
    Converts 32-bit signed integer to 32-bit floating point number
    No flags to be set
  }
  body {
    # sign of integer, it is 1 when negative
    Bits<1> sign = a[31];
    if ((a & 0x7FFFFFFF) == 0) {
      return (sign == 1) ? packToF32UI(1, 0x9E, 0) : packToF32UI(0, 0, 0);
    }
    U32 magnitude_of_A = returnMag(a);
    return softfloat_normRoundPackToF32_no_flag(sign, 0x9C, magnitude_of_A, mode);
  }
}

function softfloat_roundToI32_no_flag {
  returns Bits<32>
  arguments
    Bits<1> sign,
    Bits<64> sig,
    RoundingMode roundingMode
  description {
    Round to signed 32-bit integer, using +rounding_mode+
    No flag to be set
  }
  body {
    Bits<16> roundIncrement = 0x800;
    if (
      (roundingMode != RoundingMode::RMM)
      && (roundingMode != RoundingMode::RNE)
    ) {
      roundIncrement = 0;
      if (
        sign == 1
          ? (roundingMode == RoundingMode::RDN)
          : (roundingMode == RoundingMode::RUP)
      ) {
        roundIncrement = 0xFFF;
      }
    }
    Bits<16> roundBits = sig & 0xFFF;
    sig = sig + roundIncrement;
    if ((sig & 0xFFFFF00000000000) != 0) {
      return sign == 1 ? WORD_NEG_OVERFLOW : WORD_POS_OVERFLOW;
    }

    Bits<32> sig32 = sig >> 12;
    if (
      (roundBits == 0x800 && (roundingMode == RoundingMode::RNE))
    ) {
      sig32 = sig32 & ~32'b1;
    }

    Bits<32> z = (sign == 1) ? -sig32 : sig32;
    if ((z != 0) && (($signed(z) < 's0) != (sign == 1))) {
      return sign == 1 ? WORD_NEG_OVERFLOW : WORD_POS_OVERFLOW;
    }

    return z;
  }
}

function f32_to_i32_no_flag {
  returns U32
  arguments
    U32 a,
    RoundingMode mode
  description {
    Converts 32-bit floating point number to a signed 32-bit integer
    No flags to be set
  }
  body {
    Bits<1> sign = signF32UI(a);
    Bits<8> exp  = expF32UI(a);
    Bits<23> sig = fracF32UI(a);
    Bits<8> shiftDist;
    U64 sig64;
    # for NaN return the highest positive value and set floating-point flag to invalid.
    if ((exp == 8'hFF) && (sig != 0)) {
      sign = 0;
      return I32_NAN;
    }

    # MSB of significand is set to 1 because minimum 32-bit integer in IEEE 754 is 32'h80000000
    if (exp != 0) {
      sig = sig | 32'h00800000;
    }

    sig64 = sig `<< 32;
    shiftDist = 8'hAA - exp;

    if (shiftDist > 0) {
      sig64 = softfloat_shiftRightJam64( sig64, shiftDist);
    }

    return softfloat_roundToI32_no_flag(sign, sig64, mode);
  }
}

function round_f32_to_integral {
  returns U32
  arguments
    U32 a,
    RoundingMode mode
  description {
    Rounds 32-bit floating point number to a signed 32-bit integer.
    This 32-bit integer is represented as a floating point number and returned.
  }
  body {
    if ((is_sp_neg_inf?(a)) || (is_sp_pos_inf?(a)) || (is_sp_pos_zero?(a)) || (is_sp_neg_zero?(a))) {
      # Return zero or infinity respectively for zero or infinity inputs
      return a;
    } else if (is_sp_signaling_nan?(a)) {
      # set invalid flag for signaling NaN
      set_fp_flag(FpFlag::NV);
      return a;
    }
    # intermediate variable for storing 32-bit rounded integer
    U32 intermediate;
    # round 32-bit floating point number to integer, no flags to be set
    intermediate = f32_to_i32_no_flag(a, mode);
    # represent the integer as floating point number
    return i32_to_f32_no_flag(intermediate, mode);
  }
}

struct ExpAndSig {
  Bits<16> exp;
  Bits<32> sig;
}

function softfloat_normSubnormalF32Sig {
  returns ExpAndSig
  arguments
    Bits<32> sig
  description {
    Normalize a subnormal F32 significand.
    Returns (exp, sig32) where exp is the adjusted exponent (two's complement
    in Bits<16>) and sig32 is the normalized significand with implicit leading 1
    at bit 23. The exponent is widened to Bits<16> (rather than the natural
    Bits<8>) so that callers can add two adjusted exponents together (e.g.
    expA + expB - bias) without overflow.
  }
  body {
    Bits<16> shiftDist = count_leading_zeros(32, sig) - 8;
    ExpAndSig ret;
    ret.exp = 1 - shiftDist;
    ret.sig = sig << shiftDist;
    return ret;
  }
}

function softfloat_shortShiftRightJam64 {
  returns Bits<64>
  arguments
    Bits<64> a,
    Bits<8> dist
  description {
    Shifts +a+ right by +dist+ bits (dist must be in 1..31), jamming any
    shifted-off bits into the least-significant bit of the result.
  }
  body {
    return a >> dist | (((a & ((64'h1 << dist) - 1)) != 0) ? 1 : 0);
  }
}

function softfloat_roundToI64 {
  returns Bits<64>
  arguments
    Bits<1> sign,
    Bits<64> sig,
    Bits<64> sigExtra,
    RoundingMode roundingMode
  description {
    Round to signed 64-bit integer, using +roundingMode+.
    Translated from Berkeley Softfloat softfloat_roundToI64.
  }
  body {
    Bits<64> z;
    Boolean needs_increment = false;

    if ((roundingMode == RoundingMode::RMM) || (roundingMode == RoundingMode::RNE)) {
      if (64'h8000000000000000 <= sigExtra) {
        needs_increment = true;
      }
    } else {
      if ((sigExtra != 0) && ((sign != 0) ? (roundingMode == RoundingMode::RDN) : (roundingMode == RoundingMode::RUP))) {
        needs_increment = true;
      }
    }

    if (needs_increment) {
      sig = sig + 1;
      if (sig == 0) {
        set_fp_flag(FpFlag::NV);
        return (sign == 1) ? I64_NEG_OVERFLOW : I64_POS_OVERFLOW;
      }
      if ((sigExtra == 64'h8000000000000000) && (roundingMode == RoundingMode::RNE)) {
        sig = sig & ~64'h1;
      }
    }

    z = (sign == 1) ? -sig : sig;
    if ((z != 0) && (((($signed(z) < 0s) ? 1 : 0) ^ sign) == 1)) {
      set_fp_flag(FpFlag::NV);
      return (sign == 1) ? I64_NEG_OVERFLOW : I64_POS_OVERFLOW;
    }

    if (sigExtra != 0) {
      set_fp_flag(FpFlag::NX);
    }

    return z;
  }
}

function softfloat_roundToUI64 {
  returns Bits<64>
  arguments
    Bits<1> sign,
    Bits<64> sig,
    Bits<64> sigExtra,
    RoundingMode roundingMode
  description {
    Round to unsigned 64-bit integer, using +roundingMode+.
    Translated from Berkeley Softfloat softfloat_roundToUI64.
  }
  body {
    Boolean needs_increment = false;

    if ((roundingMode == RoundingMode::RMM) || (roundingMode == RoundingMode::RNE)) {
      if (64'h8000000000000000 <= sigExtra) {
        needs_increment = true;
      }
    } else {
      if (sign != 0) {
        if ((sig | sigExtra) == 0) {
          return 0;
        }
        if (roundingMode == RoundingMode::RDN) {
          set_fp_flag(FpFlag::NV);
          if (sign == 1) {
            return UI64_NEG_OVERFLOW;
          } else {
            return UI64_POS_OVERFLOW;
          }
        }
      } else {
        if ( (roundingMode == RoundingMode::RUP) && (sigExtra != 0)) {
          needs_increment = true;
        }
      }
    }

    if (needs_increment) {
      sig = sig + 1;
      if (sig == 0) {
        set_fp_flag(FpFlag::NV);
        if (sign == 1) {
          return UI64_NEG_OVERFLOW;
        } else {
          return UI64_POS_OVERFLOW;
        }
      }
      if ( (sigExtra == 64'h8000000000000000) && (roundingMode == RoundingMode::RNE)) {
        sig = sig & ~64'h1;
      }
    }

    if ( (sign != 0) && (sig != 0) ) {
      set_fp_flag(FpFlag::NV);
      if (sign == 1) {
        return UI64_NEG_OVERFLOW;
      } else {
        return UI64_POS_OVERFLOW;
      }
    }

    if (sigExtra != 0) {
      set_fp_flag(FpFlag::NX);
    }
    return sig;
  }
}

# ============================================================
# Double-Precision (f64) IEEE 754 SoftFloat implementation
# ============================================================

# DP constants
Bits<64> DP_POS_INF       = 64'b0_11111111111_0000000000000000000000000000000000000000000000000000;
Bits<64> DP_NEG_INF       = 64'b1_11111111111_0000000000000000000000000000000000000000000000000000;
Bits<64> DP_POS_ZERO      = 64'h0000_0000_0000_0000;
Bits<64> DP_NEG_ZERO      = 64'h8000_0000_0000_0000;
Bits<64> DP_CANONICAL_NAN = 64'h7FF8_0000_0000_0000;

function packToF64UI {
  returns Bits<64>
  arguments
    Bits<1> sign,
    Bits<16> exp,
    Bits<64> sig
  description {
    Pack components into a 64-bit double-precision value
  }
  body {
    return (sign `<< 63) + (exp `<< 52) + sig;
  }
}

function signF64UI {
  returns Bits<1>
  arguments
    Bits<64> a
  description {
    Extract sign-bit of a 64-bit floating point number
  }
  body {
    return a[63];
  }
}

function expF64UI {
  returns Bits<11>
  arguments
    Bits<64> a
  description {
    Extract exponent of a 64-bit floating point number
  }
  body {
    return a[62:52];
  }
}

function fracF64UI {
  returns Bits<52>
  arguments
    Bits<64> a
  description {
    Extract significand of a 64-bit floating point number
  }
  body {
    return a[51:0];
  }
}

function is_dp_nan? {
  returns Boolean
  arguments Bits<64> a
  description {
    Returns true if a is a NaN (quiet or signaling)
  }
  body {
    return (a[62:52] == 11'h7FF) && (a[51:0] != 0);
  }
}

function is_dp_signaling_nan? {
  returns Boolean
  arguments Bits<64> a
  description {
    Returns true if a is a signaling NaN
  }
  body {
    return (a[62:52] == 11'h7FF) && (a[51] == 0) && (a[50:0] != 0);
  }
}

function is_dp_quiet_nan? {
  returns Boolean
  arguments Bits<64> a
  description {
    Returns true if a is a quiet NaN
  }
  body {
    return (a[62:52] == 11'h7FF) && (a[51] == 1);
  }
}

function is_dp_pos_inf? {
  returns Boolean
  arguments Bits<64> a
  description {
    Returns true if a is positive infinity
  }
  body {
    return a == DP_POS_INF;
  }
}

function is_dp_neg_inf? {
  returns Boolean
  arguments Bits<64> a
  description {
    Returns true if a is negative infinity
  }
  body {
    return a == DP_NEG_INF;
  }
}

function is_dp_pos_zero? {
  returns Boolean
  arguments Bits<64> a
  description {
    Returns true if a is positive zero
  }
  body {
    return a == DP_POS_ZERO;
  }
}

function is_dp_neg_zero? {
  returns Boolean
  arguments Bits<64> a
  description {
    Returns true if a is negative zero
  }
  body {
    return a == DP_NEG_ZERO;
  }
}

function is_dp_neg_norm? {
  returns Boolean
  arguments Bits<64> a
  description {
    Returns true if a is a negative normal number
  }
  body {
    return (a[63] == 1) && (a[62:52] != 11'h7FF) && (a[62:52] != 0);
  }
}

function is_dp_pos_norm? {
  returns Boolean
  arguments Bits<64> a
  description {
    Returns true if a is a positive normal number
  }
  body {
    return (a[63] == 0) && (a[62:52] != 11'h7FF) && (a[62:52] != 0);
  }
}

function is_dp_neg_subnorm? {
  returns Boolean
  arguments Bits<64> a
  description {
    Returns true if a is a negative subnormal number
  }
  body {
    return (a[63] == 1) && (a[62:52] == 0) && (a[51:0] != 0);
  }
}

function is_dp_pos_subnorm? {
  returns Boolean
  arguments Bits<64> a
  description {
    Returns true if a is a positive subnormal number
  }
  body {
    return (a[63] == 0) && (a[62:52] == 0) && (a[51:0] != 0);
  }
}

struct ExpAndSig64 {
  Bits<16> exp;
  Bits<64> sig;
}

function softfloat_normSubnormalF64Sig {
  returns ExpAndSig64
  arguments
    Bits<64> sig
  description {
    Normalize a subnormal F64 significand.
    Returns (exp, sig64) where exp is the adjusted exponent and sig64 is
    the normalized significand with implicit leading 1 at bit 52.
  }
  body {
    Bits<16> shiftDist = count_leading_zeros(64, sig) - 11;
    ExpAndSig64 ret;
    ret.exp = 1 - shiftDist;
    ret.sig = sig << shiftDist;
    return ret;
  }
}

function softfloat_roundPackToF64 {
  returns Bits<64>
  arguments
    Bits<1> sign,
    Bits<16> exp,
    Bits<64> sig,
    RoundingMode mode
  description {
    Round FP value according to mode and then pack it in IEEE 754 double-precision format.
    Translated from Berkeley Softfloat softfloat_roundPackToF64.
  }
  body {
    Bits<16> roundIncrement = 0x200;
    if ((mode != RoundingMode::RNE) && (mode != RoundingMode::RMM)) {
      roundIncrement = (mode == ((sign != 0) ? RoundingMode::RDN : RoundingMode::RUP)) ? 0x3FF : 0;
    }
    Bits<16> roundBits = sig & 0x3FF;

    if (0x7FD <= exp) {
      if ($signed(exp) < 's0) {
        Boolean isTiny = ($signed($signed(exp) + 2) <= 0s) || (sig + roundIncrement < 64'h8000000000000000);
        Bits<16> shiftAmt = -$signed(exp);
        sig = softfloat_shiftRightJam64(sig, shiftAmt);
        exp = 0;
        roundBits = sig & 0x3FF;
        if (isTiny && (roundBits != 0)) { set_fp_flag(FpFlag::UF); }
      } else if (16'sh7FD < $signed(exp) || (64'h8000000000000000 <= sig + roundIncrement)) {
        set_fp_flag(FpFlag::OF);
        set_fp_flag(FpFlag::NX);
        return packToF64UI(sign, 0x7FF, 0) - ((roundIncrement == 0) ? 1 : 0);
      }
    }
    sig = (sig + roundIncrement) >> 10;
    if (roundBits != 0) { set_fp_flag(FpFlag::NX); }
    if ((roundBits == 0x200) && (mode == RoundingMode::RNE)) { sig = sig & ~64'b1; }
    if (sig == 0) { exp = 0; }
    return packToF64UI(sign, exp, sig);
  }
}

function softfloat_normRoundPackToF64 {
  returns Bits<64>
  arguments
    Bits<1> sign,
    Bits<16> exp,
    Bits<64> sig,
    RoundingMode mode
  description {
    Normalize, round, and pack into a 64-bit double-precision value.
    Translated from Berkeley Softfloat softfloat_normRoundPackToF64.
  }
  body {
    Bits<8> shiftDist = count_leading_zeros(64, sig) - 1;
    exp = exp - shiftDist;
    if ((10 <= shiftDist) && (exp < 0x7FD)) {
      return packToF64UI(sign, (sig != 0) ? exp : 0, sig << (shiftDist - 10));
    } else {
      return softfloat_roundPackToF64(sign, exp, sig << shiftDist, mode);
    }
  }
}

function softfloat_addMagsF64 {
  returns U64
  arguments
    U64 a,
    U64 b,
    RoundingMode mode
  description {
    Returns sum of the magnitudes of 2 double-precision floating point numbers.
    Translated from Berkeley Softfloat softfloat_addMagsF64.
  }
  body {
    if (is_dp_signaling_nan?(a) || is_dp_signaling_nan?(b)) {
      set_fp_flag(FpFlag::NV);
    }

    Bits<16> expA = expF64UI(a);
    Bits<64> sigA = fracF64UI(a);
    Bits<16> expB = expF64UI(b);
    Bits<64> sigB = fracF64UI(b);

    U64 sigZ;
    Bits<1> signZ;
    Bits<16> expZ;
    Bits<16> expDiff = expA - expB;

    if (expDiff == 16'd0) {
      if (expA == 11'h0) {
        return (a + sigB);
      }

      if (expA == 11'h7FF) {
        if ((sigA != 0) || (sigB != 0)) {
          return DP_CANONICAL_NAN;
        }
        return a;
      }

      signZ = signF64UI(a);
      expZ = expA;
      sigZ = 64'h0020000000000000 + sigA + sigB;

      if (((sigZ & 1) == 0) && (expZ < 16'h7FE)) {
        sigZ = sigZ >> 1;
        return (64'h0 + (signZ `<< 63) + (expZ `<< 52) + sigZ);
      }

      sigZ = sigZ << 9;
    } else {
      signZ = signF64UI(a);
      sigA = sigA << 9;
      sigB = sigB << 9;

      if ($signed(expDiff) < 0s) {
        if (expB == 11'h7FF) {
          if (sigB != 0) {
            return DP_CANONICAL_NAN;
          }
          return packToF64UI(signZ, 11'h7FF, 0);
        }
        expZ = expB;
        sigA = (expA == 0) ? 2*sigA : (sigA + 64'h2000000000000000);
        sigA = softfloat_shiftRightJam64(sigA, -expDiff);
      } else {
        if (expA == 11'h7FF) {
          if (sigA != 0) {
            return DP_CANONICAL_NAN;
          }
          return a;
        }
        expZ = expA;
        sigB = (expB == 0) ? 2*sigB : (sigB + 64'h2000000000000000);
        sigB = softfloat_shiftRightJam64(sigB, expDiff);
      }

      sigZ = 64'h2000000000000000 + sigA + sigB;
      if (sigZ < 64'h4000000000000000) {
        expZ = expZ - 1;
        sigZ = sigZ << 1;
      }
    }
    return softfloat_roundPackToF64(signZ, expZ, sigZ, mode);
  }
}

function softfloat_subMagsF64 {
  returns U64
  arguments
    U64 a,
    U64 b,
    RoundingMode mode
  description {
    Returns difference of the magnitudes of 2 double-precision floating point numbers.
    Translated from Berkeley Softfloat softfloat_subMagsF64.
  }
  body {
    if (is_dp_signaling_nan?(a) || is_dp_signaling_nan?(b)) {
      set_fp_flag(FpFlag::NV);
    }

    Bits<16> expA = expF64UI(a);
    Bits<64> sigA = fracF64UI(a);
    Bits<16> expB = expF64UI(b);
    Bits<64> sigB = fracF64UI(b);

    U64 sigZ;
    Bits<1> signZ;
    Bits<16> expZ;
    U64 sigDiff;
    U64 sigX;
    U64 sigY;
    Bits<8> shiftDist;

    Bits<16> expDiff = expA - expB;

    if (expDiff == 16'd0) {
      if (expA == 11'h7FF) {
        if ((sigA != 0) || (sigB != 0)) {
          return DP_CANONICAL_NAN;
        }
        set_fp_flag(FpFlag::NV);
        return DP_CANONICAL_NAN;
      }

      signZ = signF64UI(a);
      if (sigA == sigB) {
        return packToF64UI(((mode == RoundingMode::RDN) ? 1 : 0), 0, 0);
      }
      if (sigA < sigB) {
        signZ = signZ ^ 1'b1;
        sigDiff = sigB - sigA;
      } else {
        sigDiff = sigA - sigB;
      }

      if (expA != 0) {
        expA = expA - 1;
      }

      shiftDist = count_leading_zeros(64, sigDiff) - 11;
      expZ = expA - shiftDist;

      if ($signed(expZ) < 0) {
        shiftDist = expA;
        expZ = 0;
      }

      return packToF64UI(signZ, expZ, sigDiff << shiftDist);

    } else {
      signZ = signF64UI(a);
      sigA = sigA << 10;
      sigB = sigB << 10;
      if ($signed(expDiff) < 0s) {
        signZ = signZ ^ 1'b1;
        if (expB == 11'h7FF) {
          if (sigB != 0) {
            return DP_CANONICAL_NAN;
          }
          return packToF64UI(signZ, expB, 0);
        }
        expZ = expB - 1;
        sigX = sigB | 64'h4000000000000000;
        sigY = sigA + ((expA != 0) ? 64'h4000000000000000 : sigA);
        expDiff = -expDiff;
      } else {
        if (expA == 11'h7FF) {
          if (sigA != 0) {
            return DP_CANONICAL_NAN;
          }
          return a;
        }
        expZ = expA - 1;
        sigX = sigA | 64'h4000000000000000;
        sigY = sigB + ((expB != 0) ? 64'h4000000000000000 : sigB);
      }
      return softfloat_normRoundPackToF64(signZ, expZ, sigX - softfloat_shiftRightJam64(sigY, expDiff), mode);
    }
  }
}

function f64_add {
  returns U64
  arguments
    U64 a,
    U64 b,
    RoundingMode mode
  description {
    Returns sum of 2 double-precision floating point numbers
  }
  body {
    U64 a_xor_b = a ^ b;
    if (signF64UI(a_xor_b) == 1) {
      return softfloat_subMagsF64(a, b, mode);
    } else {
      return softfloat_addMagsF64(a, b, mode);
    }
  }
}

function f64_sub {
  returns U64
  arguments
    U64 a,
    U64 b,
    RoundingMode mode
  description {
    Returns difference of 2 double-precision floating point numbers
  }
  body {
    U64 a_xor_b = a ^ b;
    if (signF64UI(a_xor_b) == 1) {
      return softfloat_addMagsF64(a, b, mode);
    } else {
      return softfloat_subMagsF64(a, b, mode);
    }
  }
}

function mul64Hi {
  returns Bits<64>
  arguments
    Bits<64> a,
    Bits<64> b
  description {
    Returns the upper 64 bits of the 128-bit product of two 64-bit unsigned integers.
    Uses four 32x32->64 multiplies to compute the full 128-bit product.
  }
  body {
    Bits<64> a_hi = a >> 32;
    Bits<64> a_lo = a & 64'hFFFFFFFF;
    Bits<64> b_hi = b >> 32;
    Bits<64> b_lo = b & 64'hFFFFFFFF;

    Bits<64> lo_lo = a_lo `* b_lo;
    Bits<64> hi_lo = a_hi `* b_lo;
    Bits<64> lo_hi = a_lo `* b_hi;
    Bits<64> hi_hi = a_hi `* b_hi;

    Bits<64> cross = (lo_lo >> 32) + (hi_lo & 64'hFFFFFFFF) + (lo_hi & 64'hFFFFFFFF);
    return hi_hi + (hi_lo >> 32) + (lo_hi >> 32) + (cross >> 32);
  }
}

function f64_mul {
  returns U64
  arguments
    U64 a,
    U64 b,
    RoundingMode mode
  description {
    Multiplies two 64-bit double-precision floating point numbers.
    Translated from Berkeley Softfloat f64_mul.
  }
  body {
    if (is_dp_signaling_nan?(a) || is_dp_signaling_nan?(b)) {
      set_fp_flag(FpFlag::NV);
    }
    Bits<1> signA = signF64UI(a);
    Bits<16> expA = expF64UI(a);
    Bits<64> fracA = fracF64UI(a);
    Bits<1> signB = signF64UI(b);
    Bits<16> expB = expF64UI(b);
    Bits<64> fracB = fracF64UI(b);
    Bits<1> signZ = signA ^ signB;

    Bits<64> sigA = fracA;
    Bits<64> sigB = fracB;
    Bits<16> expZ;
    Bits<64> sigZ;

    if (expA == 11'h7FF) {
      if ((fracA != 0) || ((expB == 11'h7FF) && (fracB != 0))) {
        return DP_CANONICAL_NAN;
      }
      if ((expB == 0) && (fracB == 0)) {
        set_fp_flag(FpFlag::NV);
        return DP_CANONICAL_NAN;
      }
      return packToF64UI(signZ, 11'h7FF, 0);
    }
    if (expB == 11'h7FF) {
      if (fracB != 0) {
        return DP_CANONICAL_NAN;
      }
      if ((expA == 0) && (fracA == 0)) {
        set_fp_flag(FpFlag::NV);
        return DP_CANONICAL_NAN;
      }
      return packToF64UI(signZ, 11'h7FF, 0);
    }

    if (expA == 0) {
      if (fracA == 0) { return packToF64UI(signZ, 0, 0); }
      ExpAndSig64 norm = softfloat_normSubnormalF64Sig(fracA);
      expA = norm.exp;
      sigA = norm.sig;
    }

    if (expB == 0) {
      if (fracB == 0) { return packToF64UI(signZ, 0, 0); }
      ExpAndSig64 norm = softfloat_normSubnormalF64Sig(fracB);
      expB = norm.exp;
      sigB = norm.sig;
    }

    expZ = expA + expB - 16'h03FF;
    sigA = (sigA | 64'h0010000000000000) << 10;
    sigB = (sigB | 64'h0010000000000000) << 11;
    Bits<64> sigZ_hi = mul64Hi(sigA, sigB);
    Bits<64> sigZ_lo = sigA `* sigB;  # lower 64 bits for jam
    sigZ = sigZ_hi | ((sigZ_lo != 0) ? 1 : 0);
    if (sigZ < 64'h4000000000000000) {
      expZ = expZ - 1;
      sigZ = sigZ << 1;
    }

    return softfloat_roundPackToF64(signZ, expZ, sigZ, mode);
  }
}

function f64_div {
  returns U64
  arguments
    U64 a,
    U64 b,
    RoundingMode mode
  description {
    Divides two 64-bit double-precision floating point numbers.
    Translated from Berkeley Softfloat f64_div.
  }
  body {
    if (is_dp_signaling_nan?(a) || is_dp_signaling_nan?(b)) {
      set_fp_flag(FpFlag::NV);
    }
    Bits<1> signA = signF64UI(a);
    Bits<16> expA = expF64UI(a);
    Bits<64> sigA = fracF64UI(a);
    Bits<1> signB = signF64UI(b);
    Bits<16> expB = expF64UI(b);
    Bits<64> sigB = fracF64UI(b);
    Bits<1> signZ = signA ^ signB;

    Bits<16> expZ;

    if (expA == 11'h7FF) {
      if (sigA != 0) { return DP_CANONICAL_NAN; }
      if (expB == 11'h7FF) {
        if (sigB != 0) { return DP_CANONICAL_NAN; }
        set_fp_flag(FpFlag::NV);
        return DP_CANONICAL_NAN;
      }
      return packToF64UI(signZ, 11'h7FF, 0);
    }
    if (expB == 11'h7FF) {
      if (sigB != 0) { return DP_CANONICAL_NAN; }
      return packToF64UI(signZ, 0, 0);
    }

    if (expB == 0) {
      if (sigB == 0) {
        if ((expA == 0) && (sigA == 0)) {
          set_fp_flag(FpFlag::NV);
          return DP_CANONICAL_NAN;
        }
        set_fp_flag(FpFlag::DZ);
        return packToF64UI(signZ, 11'h7FF, 0);
      }
      ExpAndSig64 norm = softfloat_normSubnormalF64Sig(sigB);
      expB = norm.exp;
      sigB = norm.sig;
    }

    if (expA == 0) {
      if (sigA == 0) { return packToF64UI(signZ, 0, 0); }
      ExpAndSig64 norm = softfloat_normSubnormalF64Sig(sigA);
      expA = norm.exp;
      sigA = norm.sig;
    }

    expZ = expA - expB + 16'h03FE;
    sigA = sigA | 64'h0010000000000000;
    sigB = sigB | 64'h0010000000000000;

    if (sigA < sigB) {
      expZ = expZ - 1;
      sigA = sigA << 11;
    } else {
      sigA = sigA << 10;
    }
    sigB = sigB << 11;

    Bits<32> recip32 = softfloat_approxRecip32_1(sigB >> 32);
    Bits<64> sigZ = (sigA `* recip32) >> 32;
    sigZ = sigZ + 2;

    if ((sigZ & 7) <= 2) {
      sigZ = sigZ & ~64'h3;
      Bits<64> rem = (sigA `<< 31) - sigZ `* (sigB >> 1);
      if ((rem & 64'h8000000000000000) != 0) {
        sigZ = sigZ - 4;
      } else {
        if (rem != 0) {
          sigZ = sigZ | 1;
        }
      }
    }

    return softfloat_roundPackToF64(signZ, expZ, sigZ, mode);
  }
}

function f64_sqrt {
  returns U64
  arguments
    U64 a,
    RoundingMode mode
  description {
    Computes the square root of a 64-bit double-precision floating point number.
    Translated from Berkeley Softfloat f64_sqrt.
  }
  body {
    if (is_dp_signaling_nan?(a)) {
      set_fp_flag(FpFlag::NV);
    }
    Bits<1> signA = signF64UI(a);
    Bits<16> expA = expF64UI(a);
    Bits<64> fracA = fracF64UI(a);

    if (expA == 11'h7FF) {
      if (fracA != 0) { return DP_CANONICAL_NAN; }
      if (signA == 0) { return a; }
      set_fp_flag(FpFlag::NV);
      return DP_CANONICAL_NAN;
    }
    if (signA == 1) {
      if ((expA == 0) && (fracA == 0)) { return a; }
      set_fp_flag(FpFlag::NV);
      return DP_CANONICAL_NAN;
    }
    if (expA == 0) {
      if (fracA == 0) { return a; }
      ExpAndSig64 norm = softfloat_normSubnormalF64Sig(fracA);
      expA = norm.exp;
      fracA = norm.sig;
    }

    Bits<16> adjExp = expA - 16'h03FF;
    Bits<16> expZ = ((adjExp >> 1) ^ (adjExp & 16'h8000)) + 16'h03FE;
    Bits<1> oddExpA = expA[0];
    Bits<64> sigA64 = (fracA | 64'h0010000000000000) << 10;
    Bits<32> sigA32 = sigA64 >> 32;
    Bits<32> sigZ32 = (sigA32 `* softfloat_approxRecipSqrt32_1(oddExpA, sigA32)) >> 32;
    if (oddExpA == 1) {
      sigZ32 = sigZ32 >> 1;
    }
    sigZ32 = sigZ32 + 2;

    Bits<64> sigZ = sigZ32 `<< 32;
    if ((sigZ32 & 0x3F) < 2) {
      Bits<64> shiftedSigZ = sigZ >> 2;
      Bits<64> negRem = shiftedSigZ `* shiftedSigZ;
      sigZ = sigZ & ~64'h3;
      if ((negRem & 64'h8000000000000000) != 0) {
        sigZ = sigZ | 1;
      } else {
        if (negRem != 0) { sigZ = sigZ - 1; }
      }
    }

    return softfloat_roundPackToF64(0, expZ, sigZ, mode);
  }
}

function f64_muladd {
  returns U64
  arguments
    U64 a,
    U64 b,
    U64 c,
    F32MulAddOp op,
    RoundingMode mode
  description {
    Fused multiply-add for double-precision floats.
    Computes (a * b) + c, with sign modifications based on op.
    Translated from Berkeley Softfloat softfloat_mulAddF64.
  }
  body {
    if (is_dp_signaling_nan?(a) || is_dp_signaling_nan?(b) || is_dp_signaling_nan?(c)) {
      set_fp_flag(FpFlag::NV);
    }
    Bits<1>  signA    = signF64UI(a);
    Bits<16> expA     = expF64UI(a);
    Bits<64> sigA     = fracF64UI(a);
    Bits<1>  signB    = signF64UI(b);
    Bits<16> expB     = expF64UI(b);
    Bits<64> sigB     = fracF64UI(b);
    Bits<1>  signC    = signF64UI(c) ^ ((op == F32MulAddOp::Softfloat_mulAdd_subC) ? 1 : 0);
    Bits<16> expC     = expF64UI(c);
    Bits<64> sigC     = fracF64UI(c);
    Bits<1>  signProd = (signA ^ signB) ^ ((op == F32MulAddOp::Softfloat_mulAdd_subProd) ? 1 : 0);

    Bits<64> magBits;

    # Handle NaN/Inf in A
    if (expA == 11'h7FF) {
      if ((sigA != 0) || ((expB == 11'h7FF) && (sigB != 0))) {
        return DP_CANONICAL_NAN;
      }
      magBits = expB | sigB;
      if (magBits != 0) {
        U64 zA = packToF64UI(signProd, 11'h7FF, 0);
        if (expC != 11'h7FF) {
          return zA;
        }
        if (sigC != 0) {
          return DP_CANONICAL_NAN;
        }
        if (signProd == signC) {
          return zA;
        }
      }
      set_fp_flag(FpFlag::NV);
      return DP_CANONICAL_NAN;
    }

    # Handle NaN/Inf in B
    if (expB == 11'h7FF) {
      if (sigB != 0) {
        return DP_CANONICAL_NAN;
      }
      magBits = expA | sigA;
      if (magBits != 0) {
        U64 zB = packToF64UI(signProd, 11'h7FF, 0);
        if (expC != 11'h7FF) {
          return zB;
        }
        if (sigC != 0) {
          return DP_CANONICAL_NAN;
        }
        if (signProd == signC) {
          return zB;
        }
      }
      set_fp_flag(FpFlag::NV);
      return DP_CANONICAL_NAN;
    }

    # Handle NaN/Inf in C
    if (expC == 11'h7FF) {
      if (sigC != 0) {
        return DP_CANONICAL_NAN;
      }
      return packToF64UI(signC, 11'h7FF, 0);
    }

    # Handle zero/subnormal A
    if (expA == 0) {
      if (sigA == 0) {
        if (((expC | sigC) == 0) && (signProd != signC)) {
          return packToF64UI((mode == RoundingMode::RDN) ? 1 : 0, 0, 0);
        }
        return packToF64UI(signC, expC, sigC);
      }
      ExpAndSig64 norm = softfloat_normSubnormalF64Sig(sigA);
      expA = norm.exp;
      sigA = norm.sig;
    }

    # Handle zero/subnormal B
    if (expB == 0) {
      if (sigB == 0) {
        if (((expC | sigC) == 0) && (signProd != signC)) {
          return packToF64UI((mode == RoundingMode::RDN) ? 1 : 0, 0, 0);
        }
        return packToF64UI(signC, expC, sigC);
      }
      ExpAndSig64 norm = softfloat_normSubnormalF64Sig(sigB);
      expB = norm.exp;
      sigB = norm.sig;
    }

    # Compute product: sigA * sigB where each is 53-bit with hidden bit
    # expProd = expA + expB - bias = expA + expB - 0x3FF
    # But product of two 1.xxx * 1.xxx = 1x.xxx or 11.xxx (range [1,4))
    # We want the product as a 64-bit value with the leading 1 at bit 63
    Bits<16> expProd = expA + expB - 16'h03FE;
    Bits<64> sigA_full = (sigA | 64'h0010000000000000) << 10;
    Bits<64> sigB_full = (sigB | 64'h0010000000000000) << 11;
    # mul64Hi gives top 64 bits of 128-bit product
    # sigA_full has leading 1 at bit 63, sigB_full has leading 1 at bit 63
    # product top 64: leading bits at 62+63-63=62 or 63
    U64 sigProd_hi = mul64Hi(sigA_full, sigB_full);
    U64 sigProd_lo = sigA_full `* sigB_full;
    # Normalize: ensure leading 1 is at bit 63 of sigProd_hi
    if ((sigProd_hi & 64'h8000000000000000) == 0) {
      expProd = expProd - 1;
      sigProd_hi = (sigProd_hi << 1) | (sigProd_lo >> 63);
      sigProd_lo = sigProd_lo << 1;
    }

    Bits<1>  signZ = signProd;
    Bits<16> expZ;
    Bits<64> sigZ;

    # Handle zero/subnormal C
    if (expC == 0) {
      if (sigC == 0) {
        # Product only: round to f64
        # We have sigProd_hi with leading 1 at bit 63
        # Jam sigProd_lo into bottom of sigProd_hi
        U64 sigProdJam = sigProd_hi | ((sigProd_lo != 0) ? 1 : 0);
        expZ = expProd - 1;
        sigZ = softfloat_shiftRightJam64(sigProdJam, 10);
        return softfloat_roundPackToF64(signZ, expZ, sigZ, mode);
      }
      ExpAndSig64 norm = softfloat_normSubnormalF64Sig(sigC);
      expC = norm.exp;
      sigC = norm.sig;
    }
    # sigC with hidden bit, aligned at bit 63 (shift left 11 to put hidden bit at 63)
    Bits<64> sigC_hi = (sigC | 64'h0010000000000000) << 11;

    Bits<16> expDiff = expProd - expC;

    if (signProd == signC) {
      # Same sign: add magnitudes
      # Both sigProd_hi and sigC_hi are aligned at bit 63 with exponent expProd / expC
      # Bring the smaller one to match the larger exponent
      Bits<64> sigSum_hi;
      Bits<64> sigSum_lo;
      if ($signed(expDiff) <= 0s) {
        expZ = expC;
        # Shift sigProd right by (-expDiff) to align
        Bits<16> shift = -expDiff;
        Bits<64> p_shifted_hi;
        Bits<64> p_shifted_lo;
        if (shift == 0) {
          p_shifted_hi = sigProd_hi;
          p_shifted_lo = sigProd_lo;
        } else if (shift < 64) {
          p_shifted_hi = sigProd_hi >> shift;
          p_shifted_lo = (sigProd_hi << (64 - shift)) | (sigProd_lo >> shift);
        } else {
          p_shifted_hi = 0;
          p_shifted_lo = softfloat_shiftRightJam64(sigProd_hi, shift - 64) | ((sigProd_lo != 0) ? 1 : 0);
        }
        # jam the remaining bits
        sigSum_lo = p_shifted_lo | sigProd_lo;
        sigSum_hi = sigC_hi + p_shifted_hi;
        if (sigSum_hi < sigC_hi) { sigSum_hi = sigSum_hi | 1; }  # carry shouldn't happen but be safe
      } else {
        expZ = expProd;
        Bits<64> c_shifted_hi;
        Bits<64> c_shifted_lo;
        if (expDiff < 64) {
          c_shifted_hi = sigC_hi >> expDiff;
          c_shifted_lo = sigC_hi << (64 - expDiff);
        } else {
          c_shifted_hi = 0;
          c_shifted_lo = softfloat_shiftRightJam64(sigC_hi, expDiff - 64);
        }
        sigSum_lo = sigProd_lo + c_shifted_lo;
        sigSum_hi = sigProd_hi + c_shifted_hi + ((sigSum_lo < sigProd_lo) ? 1 : 0);
      }
      # Normalize: leading 1 should be at bit 63 or 64
      if ((sigSum_hi & 64'h8000000000000000) == 0) {
        # Leading 1 at bit 62 or below -- need to check if bit 64 is set (overflow)
        if ((sigSum_hi & 64'h8000000000000000) == 0) {
          expZ = expZ `- 1;
          sigSum_hi = (sigSum_hi << 1) | (sigSum_lo >> 63);
          sigSum_lo = sigSum_lo << 1;
        }
      }
      sigZ = sigSum_hi | ((sigSum_lo != 0) ? 1 : 0);
      return softfloat_roundPackToF64(signZ, expZ, softfloat_shiftRightJam64(sigZ, 10), mode);
    } else {
      # Different signs: subtract magnitudes
      Bits<64> sigDiff_hi;
      Bits<64> sigDiff_lo;
      if ($signed(expDiff) < 0s) {
        signZ = signC;
        expZ = expC;
        Bits<16> shift = -expDiff;
        Bits<64> p_shifted_hi;
        Bits<64> p_shifted_lo;
        if (shift < 64) {
          p_shifted_hi = sigProd_hi >> shift;
          p_shifted_lo = (sigProd_hi << (64 - shift)) | (sigProd_lo >> shift);
        } else {
          p_shifted_hi = 0;
          p_shifted_lo = softfloat_shiftRightJam64(sigProd_hi, shift - 64) | ((sigProd_lo != 0) ? 1 : 0);
        }
        p_shifted_lo = p_shifted_lo | ((sigProd_lo != 0) ? 1 : 0);
        # sigC - shifted_prod (C has no lo word)
        # borrow into hi = 1 if p_shifted_lo != 0 (since 0 - nonzero borrows)
        sigDiff_hi = sigC_hi - p_shifted_hi - ((p_shifted_lo != 0) ? 1 : 0);
        sigDiff_lo = -p_shifted_lo;
      } else if (expDiff == 0) {
        expZ = expProd;
        # sigProd - sigC
        if ((sigProd_hi < sigC_hi) || ((sigProd_hi == sigC_hi) && (sigProd_lo < 0))) {
          signZ = signZ ^ 1;
          sigDiff_hi = sigC_hi - sigProd_hi;
          sigDiff_lo = 0 - sigProd_lo;
        } else {
          sigDiff_hi = sigProd_hi - sigC_hi;
          sigDiff_lo = sigProd_lo;
        }
        if ((sigDiff_hi == 0) && (sigDiff_lo == 0)) {
          return packToF64UI((mode == RoundingMode::RDN) ? 1 : 0, 0, 0);
        }
      } else {
        expZ = expProd;
        Bits<64> c_shifted_hi;
        Bits<64> c_shifted_lo;
        if (expDiff < 64) {
          c_shifted_hi = sigC_hi >> expDiff;
          c_shifted_lo = sigC_hi << (64 - expDiff);
        } else {
          c_shifted_hi = 0;
          c_shifted_lo = softfloat_shiftRightJam64(sigC_hi, expDiff - 64);
        }
        c_shifted_lo = c_shifted_lo | 1;  # jam
        sigDiff_hi = sigProd_hi - c_shifted_hi - ((c_shifted_lo > sigProd_lo) ? 1 : 0);
        sigDiff_lo = sigProd_lo - c_shifted_lo;
      }
      # Normalize sigDiff
      if (sigDiff_hi == 0) {
        # leading 1 is in sigDiff_lo
        Bits<8> clzLo = count_leading_zeros(64, sigDiff_lo);
        expZ = expZ `- 64 - clzLo;
        sigZ = softfloat_shiftRightJam64(sigDiff_lo << clzLo, 10);
      } else {
        Bits<8> clz = count_leading_zeros(64, sigDiff_hi);
        expZ = expZ - clz;
        if (clz == 0) {
          sigZ = softfloat_shiftRightJam64(sigDiff_hi | ((sigDiff_lo != 0) ? 1 : 0), 10);
        } else {
          sigZ = softfloat_shiftRightJam64((sigDiff_hi << clz) | (sigDiff_lo >> (64 - clz)), 10);
        }
      }
      return softfloat_roundPackToF64(signZ, expZ, sigZ, mode);
    }
  }
}

function f32_to_f64 {
  returns U64
  arguments
    U32 a
  description {
    Converts a 32-bit single-precision float to 64-bit double-precision.
    Translated from Berkeley Softfloat f32_to_f64.
  }
  body {
    Bits<1>  sign = signF32UI(a);
    Bits<16> exp  = expF32UI(a);
    Bits<32> frac = fracF32UI(a);

    if (exp == 8'hFF) {
      if (frac != 0) {
        if (is_sp_signaling_nan?(a)) {
          set_fp_flag(FpFlag::NV);
        }
        return DP_CANONICAL_NAN;
      }
      return packToF64UI(sign, 11'h7FF, 0);
    }

    if (exp == 0) {
      if (frac == 0) {
        return packToF64UI(sign, 0, 0);
      }
      ExpAndSig norm = softfloat_normSubnormalF32Sig(frac);
      exp = norm.exp;
      frac = norm.sig & ~32'h00800000;
    }

    return packToF64UI(sign, exp + 16'h0380, frac `<< 29);
  }
}

function f64_to_f32 {
  returns U32
  arguments
    U64 a,
    RoundingMode mode
  description {
    Converts a 64-bit double-precision float to 32-bit single-precision.
    Translated from Berkeley Softfloat f64_to_f32.
  }
  body {
    Bits<1>  sign = signF64UI(a);
    Bits<16> exp  = expF64UI(a);
    Bits<64> frac = fracF64UI(a);

    if (exp == 11'h7FF) {
      if (frac != 0) {
        if (is_dp_signaling_nan?(a)) {
          set_fp_flag(FpFlag::NV);
        }
        return SP_CANONICAL_NAN;
      }
      return packToF32UI(sign, 8'hFF, 0);
    }

    Bits<32> frac32 = softfloat_shiftRightJam64(frac, 22);
    if ((exp | frac32) == 0) {
      return packToF32UI(sign, 0, 0);
    }

    return softfloat_roundPackToF32(sign, exp - 16'h0381, 0x40000000 | frac32, mode);
  }
}

function f64_to_f32_rod {
  returns U32
  arguments
    U64 a
  description {
    Converts a 64-bit double-precision float to 32-bit single-precision using round-to-odd.
    If the result is inexact, the LSB of the f32 mantissa is forced to 1.
  }
  body {
    Bits<1>  sign = signF64UI(a);
    Bits<16> exp  = expF64UI(a);
    Bits<64> frac = fracF64UI(a);

    if (exp == 11'h7FF) {
      if (frac != 0) {
        if (is_dp_signaling_nan?(a)) { set_fp_flag(FpFlag::NV); }
        return SP_CANONICAL_NAN;
      }
      return packToF32UI(sign, 8'hFF, 0);
    }

    Bits<32> frac32 = softfloat_shiftRightJam64(frac, 22);
    if ((exp | frac32) == 0) {
      return packToF32UI(sign, 0, 0);
    }

    # Convert with round-toward-zero (truncate)
    Bits<32> result = softfloat_roundPackToF32(sign, exp - 16'h0381, 0x40000000 | frac32, RoundingMode::RTZ);

    # If any bits were lost (frac had bits below position 22, or result rounded down),
    # force the LSB of the mantissa to 1 (round-to-odd)
    Bits<64> lost_bits = frac & 64'h3FFFFF;
    if (lost_bits != 0) {
      result = result | 1;
    }

    return result;
  }
}

function f64_to_i32 {
  returns Bits<32>
  arguments
    U64 a,
    RoundingMode mode
  description {
    Converts 64-bit double-precision float to a signed 32-bit integer.
    Translated from Berkeley Softfloat f64_to_i32.
  }
  body {
    Bits<1>  sign = signF64UI(a);
    Bits<16> exp  = expF64UI(a);
    Bits<64> sig  = fracF64UI(a);

    if (exp == 11'h7FF) {
      set_fp_flag(FpFlag::NV);
      if (sig != 0) {
        return I32_NAN;
      }
      return sign == 1 ? WORD_NEG_OVERFLOW : WORD_POS_OVERFLOW;
    }

    if (exp != 0) {
      sig = sig | 64'h0010000000000000;
    }

    Bits<16> shiftDist = 16'h0431 - exp;
    Bits<64> sig64 = sig `<< 10;

    if ($signed(shiftDist) > 0s) {
      sig64 = softfloat_shiftRightJam64(sig64, shiftDist);
    }

    return softfloat_roundToI32(sign, sig64, mode);
  }
}

function f64_to_ui32 {
  returns Bits<32>
  arguments
    U64 a,
    RoundingMode mode
  description {
    Converts 64-bit double-precision float to an unsigned 32-bit integer.
    Translated from Berkeley Softfloat f64_to_ui32.
  }
  body {
    Bits<1>  sign = signF64UI(a);
    Bits<16> exp  = expF64UI(a);
    Bits<64> sig  = fracF64UI(a);

    if (exp == 11'h7FF) {
      set_fp_flag(FpFlag::NV);
      if (sig != 0) {
        return UI32_NAN;
      }
      return sign == 1 ? UI32_NEG_OVERFLOW : UI32_POS_OVERFLOW;
    }

    if (exp != 0) {
      sig = sig | 64'h0010000000000000;
    }

    Bits<16> shiftDist = 16'h0431 - exp;
    Bits<64> sig64 = sig `<< 10;

    if ($signed(shiftDist) > 0s) {
      sig64 = softfloat_shiftRightJam64(sig64, shiftDist);
    }

    return softfloat_roundToUI32(sign, sig64, mode);
  }
}

function f64_to_i64 {
  returns Bits<64>
  arguments
    U64 a,
    RoundingMode mode
  description {
    Converts 64-bit double-precision float to a signed 64-bit integer.
    Translated from Berkeley Softfloat f64_to_i64.
  }
  body {
    Bits<1>  sign = signF64UI(a);
    Bits<16> exp  = expF64UI(a);
    Bits<64> sig  = fracF64UI(a);

    if (exp != 0) {
      sig = sig | 64'h0010000000000000;
    }

    Bits<16> shiftDist = 16'h043D - exp;

    if ($signed(shiftDist) < 0s) {
      set_fp_flag(FpFlag::NV);
      if ((exp == 11'h7FF) && (sig != 64'h0010000000000000)) {
        return I64_NAN;
      }
      return sign == 1 ? I64_NEG_OVERFLOW : I64_POS_OVERFLOW;
    }

    Bits<64> sig64 = sig `<< 10;
    Bits<64> extra = 0;
    if (shiftDist != 0) {
      TwoU64s sig64Extra = softfloat_shiftRightJam64Extra(sig64, 0, shiftDist);
      sig64 = sig64Extra.u1;
      extra = sig64Extra.u2;
    }
    return softfloat_roundToI64(sign, sig64, extra, mode);
  }
}

function f64_to_ui64 {
  returns Bits<64>
  arguments
    U64 a,
    RoundingMode mode
  description {
    Converts 64-bit double-precision float to an unsigned 64-bit integer.
    Translated from Berkeley Softfloat f64_to_ui64.
  }
  body {
    Bits<1>  sign = signF64UI(a);
    Bits<16> exp  = expF64UI(a);
    Bits<64> sig  = fracF64UI(a);

    if (exp != 0) {
      sig = sig | 64'h0010000000000000;
    }

    Bits<16> shiftDist = 16'h043D - exp;

    if ($signed(shiftDist) < 0s) {
      set_fp_flag(FpFlag::NV);
      if ((exp == 11'h7FF) && (sig != 64'h0010000000000000)) {
        return UI64_NAN;
      }
      return sign == 1 ? UI64_NEG_OVERFLOW : UI64_POS_OVERFLOW;
    }

    Bits<64> sig64 = sig `<< 10;
    Bits<64> extra = 0;
    if (shiftDist != 0) {
      TwoU64s sig64Extra = softfloat_shiftRightJam64Extra(sig64, 0, shiftDist);
      sig64 = sig64Extra.u1;
      extra = sig64Extra.u2;
    }
    return softfloat_roundToUI64(sign, sig64, extra, mode);
  }
}

function i32_to_f64 {
  returns U64
  arguments
    Bits<32> a,
    RoundingMode mode
  description {
    Converts 32-bit signed integer to 64-bit double-precision float.
    Translated from Berkeley Softfloat i32_to_f64.
  }
  body {
    if (a == 0) { return 0; }
    Bits<1> sign = a[31];
    Bits<64> absA = (sign == 1) ? -a : a;
    Bits<8> shiftDist = count_leading_zeros(32, absA[31:0]);
    return packToF64UI(sign, 16'h041D - shiftDist, absA << (21 + shiftDist));
  }
}

function ui32_to_f64 {
  returns U64
  arguments
    Bits<32> a,
    RoundingMode mode
  description {
    Converts 32-bit unsigned integer to 64-bit double-precision float.
    Translated from Berkeley Softfloat ui32_to_f64.
  }
  body {
    if (a == 0) { return 0; }
    Bits<64> absA = a;
    Bits<8> shiftDist = count_leading_zeros(32, a);
    return packToF64UI(0, 16'h041D - shiftDist, absA << (21 + shiftDist));
  }
}

function i64_to_f64 {
  returns U64
  arguments
    Bits<64> a,
    RoundingMode mode
  description {
    Converts 64-bit signed integer to 64-bit double-precision float.
    Translated from Berkeley Softfloat i64_to_f64.
  }
  body {
    Bits<1> sign = a[63];
    if ((a & 64'h7FFFFFFFFFFFFFFF) == 0) {
      return (sign == 1) ? packToF64UI(1, 16'h43E, 0) : 0;
    }
    Bits<64> absA = (sign == 1) ? -a : a;
    return softfloat_normRoundPackToF64(sign, 16'h43C, absA, mode);
  }
}

function ui64_to_f64 {
  returns U64
  arguments
    Bits<64> a,
    RoundingMode mode
  description {
    Converts 64-bit unsigned integer to 64-bit double-precision float.
    Translated from Berkeley Softfloat ui64_to_f64.
  }
  body {
    if (a == 0) { return 0; }
    if (a[63] == 1) {
      return softfloat_roundPackToF64(0, 16'h43D, a >> 1 | (a & 1), mode);
    } else {
      return softfloat_normRoundPackToF64(0, 16'h43C, a, mode);
    }
  }
}

function f64_to_i32_no_flag {
  returns Bits<32>
  arguments
    U64 a,
    RoundingMode mode
  description {
    Converts 64-bit double-precision float to a signed 32-bit integer, no flags set.
  }
  body {
    Bits<1>  sign = signF64UI(a);
    Bits<16> exp  = expF64UI(a);
    Bits<64> sig  = fracF64UI(a);

    if (exp == 11'h7FF) {
      if (sig != 0) {
        return I32_NAN;
      }
      return sign == 1 ? WORD_NEG_OVERFLOW : WORD_POS_OVERFLOW;
    }

    if (exp != 0) {
      sig = sig | 64'h0010000000000000;
    }

    Bits<16> shiftDist = 16'h0431 - exp;
    Bits<64> sig64 = sig `<< 10;

    if ($signed(shiftDist) > 0s) {
      sig64 = softfloat_shiftRightJam64(sig64, shiftDist);
    }

    return softfloat_roundToI32_no_flag(sign, sig64, mode);
  }
}

function i32_to_f64_no_flag {
  returns U64
  arguments
    Bits<32> a,
    RoundingMode mode
  description {
    Converts 32-bit signed integer to 64-bit double-precision float, no flags set.
  }
  body {
    if (a == 0) { return 0; }
    Bits<1> sign = a[31];
    Bits<64> absA = (sign == 1) ? -a : a;
    Bits<8> shiftDist = count_leading_zeros(64, absA) - 21;
    return packToF64UI(sign, 16'h041E - shiftDist, absA << shiftDist);
  }
}

function f64_to_i64_no_flag {
  returns Bits<64>
  arguments
    U64 a,
    RoundingMode mode
  description {
    Converts 64-bit double-precision float to a signed 64-bit integer, no flags set.
  }
  body {
    Bits<1>  sign = signF64UI(a);
    Bits<16> exp  = expF64UI(a);
    Bits<64> sig  = fracF64UI(a);

    if (exp == 11'h7FF) {
      if (sig != 0) { return I64_NAN; }
      return sign == 1 ? I64_NEG_OVERFLOW : I64_POS_OVERFLOW;
    }

    if (exp != 0) {
      sig = sig | 64'h0010000000000000;
    }

    Bits<16> shiftDist = 16'h043D - exp;

    if ($signed(shiftDist) < 0s) {
      return sign == 1 ? I64_NEG_OVERFLOW : I64_POS_OVERFLOW;
    }

    Bits<64> sig64 = sig `<< 10;
    Bits<64> extra = 0;
    if (shiftDist != 0) {
      TwoU64s sig64Extra = softfloat_shiftRightJam64Extra(sig64, 0, shiftDist);
      sig64 = sig64Extra.u1;
      extra = sig64Extra.u2;
    }
    return softfloat_roundToI64(sign, sig64, extra, mode);
  }
}

function i64_to_f64_no_flag {
  returns U64
  arguments
    Bits<64> a,
    RoundingMode mode
  description {
    Converts 64-bit signed integer to 64-bit double-precision float, no flags set.
  }
  body {
    Bits<1> sign = a[63];
    if ((a & 64'h7FFFFFFFFFFFFFFF) == 0) {
      return (sign == 1) ? packToF64UI(1, 16'h43E, 0) : 0;
    }
    Bits<64> absA = (sign == 1) ? -a : a;
    return softfloat_normRoundPackToF64(sign, 16'h43C, absA, mode);
  }
}

function round_f64_to_integral {
  returns U64
  arguments
    U64 a,
    RoundingMode mode
  description {
    Rounds 64-bit double-precision float to an integer value, returned as double.
    If the exponent is large enough that the value is already integral, return it unchanged.
  }
  body {
    if ((is_dp_neg_inf?(a)) || (is_dp_pos_inf?(a)) || (is_dp_pos_zero?(a)) || (is_dp_neg_zero?(a))) {
      return a;
    } else if (is_dp_signaling_nan?(a)) {
      set_fp_flag(FpFlag::NV);
      return a;
    } else if (is_dp_nan?(a)) {
      return a;
    }
    # If exponent >= 52, the value is already an integer
    Bits<16> exp = expF64UI(a);
    if ($signed(exp) >= 16'sh43C) {
      return a;
    }
    Bits<64> intermediate = f64_to_i64_no_flag(a, mode);
    return i64_to_f64_no_flag(intermediate, mode);
  }
}
