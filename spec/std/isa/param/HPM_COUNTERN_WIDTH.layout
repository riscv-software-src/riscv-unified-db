# yaml-language-server: $schema=../../../schemas/param_schema.json
<%- raise "'hpm_num' must be defined" if hpm_num.nil? -%>

$schema: param_schema.json#
kind: parameter
name: <%= "HPM_COUNTER#{hpm_num}_WIDTH" %>
long_name: Width of HPM counter <%= hpm_num %>
definedBy:
  allOf:
    - extension:
        name: Sm
    - param:
        name: HPM_COUNTER_EN
        index: <%= hpm_num %>
        equal: true
description: |
  The number of bits of precision implemented by `mhpmcounter<%= hpm_num %>`.

  This parameter exists only when `HPM_COUNTER_EN[<%= hpm_num %>]` is `true`.
  The privileged specification allows an HPM counter to have up to 64 bits of precision.
schema:
  type: integer
  minimum: 0
  maximum: 64
