# yaml-language-server: $schema=../../../schemas/param_schema.json
<%- raise "'stateen_num' must be defined" if stateen_num.nil? -%>

$schema: param_schema.json#
kind: parameter
name: <%= "MSTATEEN#{stateen_num}_SE0_TYPE" %>
long_name: Behavior of mstateen<%= stateen_num %>.SE0 (bit 63)
description: |
  Behavior of the `mstateen<%= stateen_num %>.SE0` bit (bit 63), which controls access to
  `hstateen<%= stateen_num %>`, `hstateen<%= stateen_num %>h`, and `sstateen<%= stateen_num %>`:

    * 'rw': read-write
    * 'read-only-0': read-only, fixed to 0
    * 'read-only-1': read-only, fixed to 1

  Bit 63 of each `mstateen` CSR may be read-only zero only if the hypervisor extension is not
  implemented and the matching supervisor-level `sstateen` CSR is all read-only zeros.
  No bits of `sstateen<%= stateen_num %>` are currently defined, so only the hypervisor
  condition applies.
schema:
  type: string
  enum:
    - rw
    - read-only-0
    - read-only-1
definedBy:
  extension:
    name: Smstateen
requirements:
  # Bit 63 of an mstateen CSR cannot be read-only zero when H is implemented
  if:
    extension:
      name: H
  then:
    param:
      name: <%= "MSTATEEN#{stateen_num}_SE0_TYPE" %>
      notEqual: read-only-0
