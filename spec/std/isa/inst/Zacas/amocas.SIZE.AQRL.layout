# yaml-language-server: $schema=../../../../schemas/inst_schema.json

$schema: "inst_schema.json#"
kind: instruction
name: amocas.{{ size }}{{ aq_rl_suffix }}
long_name: Atomic compare-and-swap {{ current_size.name }}{{ ordering_parenthetical }}
description: |
  Atomically{{ ordering_description }}:

    * Load the {{ current_size.name }} at address _xs1_
    * Write the {{ load_result_description }} into _xd_
    * Compare the loaded value with the {{ operand_description }} _xs2_
    * If equal, write the {{ operand_description }} _xs2+1_ to the address in _xs1_
definedBy:
{%- if size == "q" -%}
  allOf:
    - extension:
        name: {{ current_size.extension }}
    - xlen: 64
{%- else -%}
  extension:
    name: {{ current_size.extension }}
{%- endif -%}
assembly: xd, xs2, (xs1)
encoding:
  match: 00101{{ aq_bit }}{{ rl_bit }}----------{{ current_size.funct3 }}-----0101111
  variables:
    - name: xs2
      location: 24-20
    - name: xs1
      location: 19-15
    - name: xd
      location: 11-7
access:
  s: always
  u: always
  vs: always
  vu: always
operation(): |
  if (!implemented?(ExtensionName::{{ current_size.extension }})) {
    raise (ExceptionCode::IllegalInstruction, mode(), $encoding);
  }

{% if aq -%}
  memory_model_acquire();

{% endif -%}
  XReg virtual_address = X[xs1];
  # TODO
  # X[xd] = amocas{{ current_size.operation_bits }}(virtual_address, X[xs2]{{ value_slice }}, X[xd]{{ value_slice }}, {{ aq_bool }}, {{ rl_bool }}, $encoding);
{% if rl -%}

  memory_model_release();
{% endif -%}
