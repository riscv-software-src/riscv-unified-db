# yaml-language-server: $schema=../../../../schemas/inst_schema.json
<%-
  raise "'size' must be defined as 'b', 'h', 'w', 'd', or 'q'" unless %w[b h w d q].include?(size)
  raise "'aq' must be defined as true or false" unless [true, false].include?(aq)
  raise "'rl' must be defined as true or false" unless [true, false].include?(rl)

  size_info = {
    "b" => { name: "byte", bits: 8, funct3: "000", operation_bits: "8", extension: "Zabha" },
    "h" => { name: "halfword", bits: 16, funct3: "001", operation_bits: "16", extension: "Zabha" },
    "w" => { name: "word", bits: 32, funct3: "010", operation_bits: "32", extension: "Zacas" },
    "d" => { name: "doubleword", bits: 64, funct3: "011", operation_bits: "64", extension: "Zacas" },
    "q" => { name: "quadword", bits: 128, funct3: "100", operation_bits: "128", extension: "Zacas" }
  }

  current_size = size_info[size]

  # Generate instruction name suffix based on aq/rl
  aq_rl_suffix = ""
  if aq && rl
    aq_rl_suffix = ".aqrl"
  elsif aq
    aq_rl_suffix = ".aq"
  elsif rl
    aq_rl_suffix = ".rl"
  end

  # Generate match string with fixed aq/rl bits (funct5 = 00101 for amocas)
  aq_bit = aq ? "1" : "0"
  rl_bit = rl ? "1" : "0"
-%>

$schema: "inst_schema.json#"
kind: instruction
name: amocas.<%= size %><%= aq_rl_suffix %>
long_name: Atomic compare-and-swap <%= current_size[:name] %><%= aq && rl ? " (acquire-release)" : (aq ? " (acquire)" : (rl ? " (release)" : "")) %>
description: |
  Atomically<%= aq && rl ? " with acquire and release ordering" : (aq ? " with acquire ordering" : (rl ? " with release ordering" : "")) %>:

    * Load the <%= current_size[:name] %> at address _xs1_
<%- if size == "w" -%>
    * Compare the loaded value with the least-significant word of register _xd_
    * If they are bitwise equal, write the least-significant word of register _xs2_ to the address in _xs1_
    * Write the sign-extended loaded value into _xd_
<%- elsif size == "d" -%>
    * Compare the loaded value with the value held in _xd_ (RV64), or in the register pair _xd_ and _xd+1_ (RV32)
    * If they are bitwise equal, write the value held in _xs2_ (RV64), or in the register pair _xs2_ and _xs2+1_ (RV32), to the address in _xs1_
    * Write the loaded value into _xd_ (RV64), or into the register pair _xd_ and _xd+1_ (RV32)
<%- else -%>

    * Load the <%= current_size[:name] %> at address _xs1_
    * Write the <%= %w[b h w].include?(size) ? "sign-extended value" : "loaded value" %> into _xd_
    * Compare the loaded value with the <%= %w[b h w].include?(size) ? "least-significant #{current_size[:name]} of register" : "value of register" %> _xs2_
    * If equal, write the <%= %w[b h w].include?(size) ? "least-significant #{current_size[:name]} of register" : "value of register" %> _xs2+1_ to the address in _xs1_
<%- end -%>
definedBy:
<%- if size == "q" -%>
  allOf:
    - extension:
        name: <%= current_size[:extension] %>
    - xlen: 64
<%- else -%>
  extension:
    name: <%= current_size[:extension] %>
<%- end -%>
assembly: xd, xs2, (xs1)
encoding:
  match: 00101<%= aq_bit %><%= rl_bit %>----------<%= current_size[:funct3] %>-----0101111
  variables:
    - name: xs2
      location: 24-20
    - name: xs1
      location: 19-15
    - name: xd
      location: 11-7
access:
  s: always
  u: always
  vs: always
  vu: always
operation(): |
<%- if size == "w" -%>
  XReg virtual_address = X[xs1];

  Bits<64> original_value =
    amo_cas(32, virtual_address, X[xd][31:0], X[xs2][31:0], <%= aq ? "1'b1" : "1'b0" %>, <%= rl ? "1'b1" : "1'b0" %>, $encoding);

  X[xd] = sext(original_value[31:0], 32);
<%- elsif size == "d" -%>
  XReg virtual_address = X[xs1];

  if (xlen() == 32) {
    # the first register of each pair must be even numbered; odd encodings are reserved
    if ((xd[0] == 1) || (xs2[0] == 1)) {
      raise (ExceptionCode::IllegalInstruction, mode(), $encoding);
    }

    # when the first register of a source pair is x0, both halves of the pair read as zero
    Bits<64> compare_value = (xd == 0)  ? 64'h0 : {X[xd + 1], X[xd]};
    Bits<64> swap_value    = (xs2 == 0) ? 64'h0 : {X[xs2 + 1], X[xs2]};

    Bits<64> original_value =
      amo_cas(64, virtual_address, compare_value, swap_value, <%= aq ? "1'b1" : "1'b0" %>, <%= rl ? "1'b1" : "1'b0" %>, $encoding);

    # when the first register of the destination pair is x0, the result is discarded
    if (xd != 0) {
      X[xd]     = original_value[31:0];
      X[xd + 1] = original_value[63:32];
    }
  } else {
    X[xd] = amo_cas(64, virtual_address, X[xd], X[xs2], <%= aq ? "1'b1" : "1'b0" %>, <%= rl ? "1'b1" : "1'b0" %>, $encoding);
  }
<%- else -%>
  if (!implemented?(ExtensionName::<%= current_size[:extension] %>)) {
    raise (ExceptionCode::IllegalInstruction, mode(), $encoding);
  }

<% if aq -%>
  memory_model_acquire();

<% end -%>
  XReg virtual_address = X[xs1];
  # TODO
  # X[xd] = amocas<%= current_size[:operation_bits] %>(virtual_address, X[xs2]<%= %w[b h w].include?(size) ? "[#{current_size[:bits]-1}:0]" : "" %>, X[xd]<%= %w[b h w].include?(size) ? "[#{current_size[:bits]-1}:0]" : "" %>, <%= aq ? "1'b1" : "1'b0" %>, <%= rl ? "1'b1" : "1'b0" %>, $encoding);
<% if rl -%>

  memory_model_release();
<% end -%>
<%- end -%>
