# yaml-language-server: $schema=../../../../schemas/inst_schema.json

$schema: "inst_schema.json#"
kind: instruction
name: amomax.{{ size }}{{ aq_rl_suffix }}
long_name: Atomic MAX {{ current_size.name }}{{ ordering_parenthetical }}
description: |
  Atomically{{ ordering_description }}:

    * Load the {{ current_size.name }} at address _xs1_
    * Write the {{ load_result_description }} into _xd_
    * Signed compare the {{ operand_description }} _xs2_ to the loaded value, and select the maximum value
    * Write the maximum to the address in _xs1_
definedBy:
{%- if size == "d" -%}
  allOf:
    - extension:
        name: {{ amo_extension }}
    - xlen: 64
{%- else -%}
  extension:
    name: {{ amo_extension }}
{%- endif -%}
assembly: xd, xs2, (xs1)
encoding:
  match: 10100{{ aq_bit }}{{ rl_bit }}----------{{ current_size.funct3 }}-----0101111
  variables:
    - name: xs2
      location: 24-20
    - name: xs1
      location: 19-15
    - name: xd
      location: 11-7
access:
  s: always
  u: always
  vs: always
  vu: always
operation(): |
{% if aq -%}
  memory_model_acquire();

{% endif -%}
  XReg virtual_address = X[xs1];
  X[xd] = {{ sign_extend_prefix }}amo({{ current_size.operation_bits }}, virtual_address, X[xs2]{{ value_slice }}, AmoOperation::Max, {{ aq_bool }}, {{ rl_bool }}, $encoding){{ sign_extend_suffix }};
{% if rl -%}

  memory_model_release();
{% endif -%}
