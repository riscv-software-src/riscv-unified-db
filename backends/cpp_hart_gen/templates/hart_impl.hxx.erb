#pragma once

#include <memory>
#include <print>

#include "udb/inst.hpp"
#include "udb/cfgs/<%= cfg_arch.name %>/inst.hxx"
#include "udb/hart.hpp"

using namespace std::literals;

namespace udb {

  <%- cfg_arch.globals.each do |global| -%>
  <%- next if global.is_a?(Idl::GlobalWithInitializationAst) && global.type(cfg_arch.symtab).const? && global.rhs.const_eval?(cfg_arch.symtab) -%>
  template <SocModel SocType>
  <%= global.type(cfg_arch.symtab).to_cxx.gsub("const ", "") %> <%= name_of(:hart, cfg_arch) %><SocType>::<%= global.id %>;
  <%- end -%>

  template <SocModel SocType>
  void <%= name_of(:hart, cfg_arch) %><SocType>::printState(FILE* out) const {
    std::print(out, "Hart {:d}:\n", this->m_hart_id);
    std::print(out, "PC: {:#x}\n", m_pc.get());
    <%- applicable_register_files.each do |rf| -%>
    <%- rf_name = rf.name.downcase -%>
    <%- rf_width = rf.eval_register_length(cfg_arch) -%>
    <%- is_rt_width = rf_width.is_a?(String) -%>
    std::print(out, "<%= rf.name %> registers:\n");
    for (unsigned i = 0; i < <%= rf.registers.count %>; i++) {
      <%- if is_rt_width -%>
      std::print(out, "<%= rf_name %>{}: {:#x}\n", i, static_cast<uint64_t>(_<%= rf_name %>reg(i).get().get_ui()));
      <%- else -%>
        <%- if rf_width > 64 -%>
        __int128 val = _<%= rf_name %>reg(i).get();
        std::print(out, "<%= rf_name %>{}: {:#x}{:x}\n", i, static_cast<uint64_t>(val >> 64), static_cast<uint64_t>(val & 0xFFFFFFFFFFFFFFFF));
        <%- else -%>
        std::print(out, "<%= rf_name %>{}: {:#x}\n", i, _<%= rf_name %>reg(i).get());
        <%- end -%>

      <%- end -%>
    }
    <%- end -%>
  }

#define __UDB_CONST_GLOBAL(global_name) <%= name_of(:hart, cfg_arch) %><SocType>::global_name
#define __UDB_MUTABLE_GLOBAL(global_name) this->global_name
#define __UDB_FUNC_CALL this->
#define __UDB_PC this->m_pc


  template <SocModel SocType>
  PossiblyUnknownBits<<%= name_of(:hart, cfg_arch) %><SocType>::INSTR_ENC_SIZE.get()> <%= name_of(:hart, cfg_arch) %><SocType>::_fetch()
  {
    <%- symtab = cfg_arch.symtab.global_clone -%>
    <%- symtab.push(cfg_arch.fetch) -%>
    <%= cfg_arch.fetch.body.prune(symtab).gen_cpp(symtab, 4) %>
    <%- symtab.release -%>
  }

  template <SocModel SocType>
  bool <%= name_of(:hart, cfg_arch) %><SocType>::_decode(
    const XReg& pc,
    const Bits<<%= cfg_arch.largest_encoding %>>& encoding,
    InstBase* inst
  ) {
    <%- if cfg_arch.multi_xlen? -%>
    if (xlen() == 32_b) {
      <%= DecodeGen.new(cfg_arch).generate(cfg_arch.possible_instructions.select { |i| i.rv32? }, 32, indent: 4) %>
    } else {
      <%= DecodeGen.new(cfg_arch).generate(cfg_arch.possible_instructions.select { |i| i.rv64? }, 64, indent: 4) %>
    }
    <%- else # just need a single decode -%>
    <%= DecodeGen.new(cfg_arch).generate(cfg_arch.possible_instructions, cfg_arch.possible_xlens[0], indent: 2) %>
    <%- end -%>

    // fall through: no instruction found
    return false;
  }

  template <SocModel SocType>
  int <%= name_of(:hart, cfg_arch) %><SocType>::_run_one()
  {
    try {

      Bits<INSTR_ENC_SIZE.get()> enc;

      this->Notify(PREFETCH_EVENT, (void*)&m_pc);
      enc = _fetch();

      this->Notify(FETCH_EVENT, (void*)&enc);
      m_cur_inst = reinterpret_cast<InstBase*>(m_run_one_inst_storage.data());
      if (_decode(m_pc, enc, m_cur_inst) == false) {
        try {
          raise(ExceptionCode{ExceptionCode::IllegalInstruction}, mode(), m_params.REPORT_ENCODING_IN_MTVAL_ON_ILLEGAL_INSTRUCTION.value() ? enc : decltype(enc){0});
        } catch (const AbortInstruction& e) {
          return StopReason::Exception;
        }
      }
      this->Notify(DECODE_EVENT, (void*)m_cur_inst);

      // set the fall-through next pc
      m_next_pc = m_pc + Bits<MXLEN>{m_cur_inst->enc_len()};

      this->Notify(PREEXECUTE_EVENT, (void*)m_cur_inst);
      m_cur_inst->execute();
      this->Notify(EXECUTE_EVENT, (void*)m_cur_inst);

      advance_pc();
      if (this->m_exit_requested) {
        this->m_exit_requested = false; // reset the request
      }
    } catch (const AbortPreExecute& e) {
      return StopReason::Exception;
    } catch (const AbortInstruction& e) {
      advance_pc();
      return StopReason::Exception;
    } catch (const udb::WfiException& e) {
      advance_pc();
      return StopReason::Wfi;
    } catch (const udb::PauseException& e) {
      advance_pc();
      return StopReason::Pause;
    } catch (const udb::UnpredictableBehaviorException& e) {
      advance_pc();
      return StopReason::UnpredictableBehavior;
    } catch (const udb::ExitEvent& e) {
      advance_pc();
      this->m_exit_code = e.code();
      this->m_exit_reason = e.what();
      if (e.code() == 0) {
        return StopReason::ExitSuccess;
      } else {
        return StopReason::ExitFailure;
      }
    }
    return StopReason::InstLimitReached;
  }

  template <SocModel SocType>
  int <%= name_of(:hart, cfg_arch) %><SocType>::_run_bb()
  {
    auto current_bb = m_bb_cache.get(m_pc.get());
    try {
      if (current_bb->start_pc() == m_pc.get()) {
        current_bb->reset(); // hit, reset to the top of the basic block

        // now execute the entire bb
        const auto bb_size = current_bb->size();

        for (unsigned b = 0; b < bb_size; b++) {
          m_cur_inst = current_bb->pop();

          // set the fall-through next pc
          m_next_pc = m_pc + Bits<MXLEN>{m_cur_inst->enc_len()};

          this->Notify(PREEXECUTE_EVENT, (void*)m_cur_inst);
          m_cur_inst->execute();
          this->Notify(EXECUTE_EVENT, (void*)m_cur_inst);

          advance_pc();
          if (this->m_exit_requested) {
            this->m_exit_requested = false;  // reset the request
            break;
          }
        }
      } else {
        // miss, need to create the bb
        current_bb->recycle(m_pc.get());
        do {
          Bits<INSTR_ENC_SIZE.get()> enc;

          this->Notify(PREFETCH_EVENT, (void*)&m_pc);
          enc = _fetch();
          this->Notify(FETCH_EVENT, (void*)&enc);

          m_cur_inst = current_bb->alloc_inst();
          if (_decode(m_pc, enc, m_cur_inst) == false) {
            try {
              raise(ExceptionCode{ExceptionCode::IllegalInstruction}, mode(), m_params.REPORT_ENCODING_IN_MTVAL_ON_ILLEGAL_INSTRUCTION.value() ? enc : decltype(enc){0});
            } catch (const AbortInstruction& e) {
              return StopReason::Exception;
            }
          }
          this->Notify(DECODE_EVENT, (void*)m_cur_inst);

          // set the fall-through next pc
          m_next_pc = m_pc + Bits<MXLEN>{m_cur_inst->enc_len()};

          this->Notify(PREEXECUTE_EVENT, (void*)m_cur_inst);
          m_cur_inst->execute();
          this->Notify(EXECUTE_EVENT, (void*)m_cur_inst);

          advance_pc();
          if (this->m_exit_requested) {
            this->m_exit_requested = false; // reset the request
            break;
          }
        } while (!(current_bb->full() || m_cur_inst->control_flow()));
      }
    } catch (const AbortPreExecute& e) {
      return StopReason::Exception;
    } catch (const AbortInstruction& e) {
      current_bb->invalidate();
      advance_pc();
      return StopReason::Exception;
    } catch (const udb::WfiException& e) {
      current_bb->invalidate();
      advance_pc();
      return StopReason::Wfi;
    } catch (const udb::PauseException& e) {
      current_bb->invalidate();
      advance_pc();
      return StopReason::Pause;
    } catch (const udb::UnpredictableBehaviorException& e) {
      current_bb->invalidate();
      advance_pc();
      return StopReason::UnpredictableBehavior;
    } catch (const udb::ExitEvent& e) {
      current_bb->invalidate();
      advance_pc();
      this->m_exit_code = e.code();
      this->m_exit_reason = e.what();
      if (e.code() == 0) {
        return StopReason::ExitSuccess;
      } else {
        return StopReason::ExitFailure;
      }
    }

    return StopReason::InstLimitReached;
  }


  template <SocModel SocType>
  int <%= name_of(:hart, cfg_arch) %><SocType>::_run_n(uint64_t n)
  {
    while (n > 0) {
      if (n >= decltype(m_bb_cache)::MAX_BASIC_BLOCK_SIZE) {
        // safe to execute a bb
        auto before = this->m_num_inst_exec;
        auto reason = _run_bb();
        if (reason != StopReason::InstLimitReached) {
          return reason;
        }
        n -= (this->m_num_inst_exec - before);
      } else {
        auto reason = _run_one();
        if (reason != StopReason::InstLimitReached) {
          return reason;
        }
        n--;
      }
    }

    return StopReason::InstLimitReached;
  }


#undef __UDB_CONST_GLOBAL
#undef __UDB_MUTABLE_GLOBAL
#undef __UDB_FUNC_CALL
#undef __UDB_PC
}
