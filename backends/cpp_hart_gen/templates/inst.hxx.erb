#pragma once

#include <udb/bits.hpp>
#include <type_traits>
#include <udb/util.hpp>
#include <udb/xregister.hpp>
#include <udb/inst.hpp>

#include "udb/cpp_exceptions.hpp"
#include "udb/cfgs/<%= cfg_arch.name %>/structs.hxx"

#ifdef assert
#undef assert
#endif

<%- ilist = cfg_arch.possible_instructions -%>

<%
  def extract_decode(dv,inst)
    ops = []
    so_far = 0
    dv.bits.each do |b|
      if b.is_a?(Integer)
        op = "this->m_encoding.template at<#{b}>()"
        ops << op
        so_far += 1
      elsif b.is_a?(Range)
        op = "this->m_encoding.template extract<#{b.last}, #{b.first}>()"
        ops << op
        so_far += b.size
      end
    end
    ops << "Bits<#{dv.left_shift}>{0}" unless dv.left_shift.zero?
    ops =
      if ops.size > 1
        "concat(#{ops.join(', ')})"
      else
        ops[0]
      end
    ops
  end
-%>

namespace udb {

#define __UDB_FUNC_CALL m_parent->
#define __UDB_CSR_BY_ADDR(addr) (*(m_parent->csr(addr)))
#define __UDB_CSR_BY_NAME(csr_name) m_parent->m_csrs.csr_name
#define __UDB_ENCODING this->_encoding()
#define __UDB_RUNTIME_PARAM(param_name) m_parent->params().param_name.value()
#define __UDB_STATIC_PARAM(param_name) <%= name_of(:params, cfg_arch) %>::param_name.value()
#define __UDB_STRUCT(type) <%= name_of(:cfg, cfg_arch) %>_ ## type ##_Struct
#define __UDB_SET_PC(new_pc) m_parent->set_next_pc(new_pc)
#define __UDB_PC m_parent->m_pc
#define __UDB_MUTABLE_GLOBAL(x) m_parent->x
#define __UDB_CONSTEXPR_FUNC_CALL <%= name_of(:hart, cfg_arch)%><SocType>::
#define __UDB_CONST_GLOBAL(F) <%= name_of(:hart, cfg_arch)%><SocType>:: F
#define __UDB_XLEN m_parent->xlen().to_defined()
#define __UDB_HART m_parent

  <%- ilist.each do |inst| -%>
  <%- needs_rv32 = inst.rv32? && cfg_arch.possible_xlens.include?(32) -%>
  <%- needs_rv64 = inst.rv64? && cfg_arch.possible_xlens.include?(64) -%>
  <%- vector_state_instruction = inst.name.downcase.start_with?("v") -%>
  <%- vector_instruction = vector_state_instruction && !%w[vsetvl vsetvli vsetivli].include?(inst.name.downcase) -%>
  <%- whole_register_vector_instruction = inst.name.downcase.match?(/\Av(?:l[1248]re(?:8|16|32|64)|s[1248]r)\.v\z/) -%>
  <%- decode_xlen = needs_rv32 ? 32 : 64 -%>
  <%- decode_variable_names = inst.decode_variables(decode_xlen).map { |dv| dv.name.to_s } -%>
  <%- vector_register_operands = %w[vd vs1 vs2 vs3].select { |name| decode_variable_names.include?(name) } -%>
  <%- implicit_v0_mask = inst.assembly.split(/\s*,\s*/).include?("v0") -%>
  <%- mask_result_instruction = inst.name.downcase.match?(/\Av(?:m(?:adc|sbc|seq|sne|sltu?|sleu?|sgtu?)|mf(?:eq|ne|lt|le|gt|ge))\./) -%>
  <%- reduction_instruction = inst.name.downcase.match?(/\Av(?:f|w|fw)?red/) -%>
  <%- vector_fp_instruction = (inst.name.downcase.start_with?("vf") || inst.name.downcase.start_with?("vmf")) && !inst.name.downcase.start_with?("vfirst") && !inst.name.downcase.match?(/\Avfwcvt\.f\.x(?:u)?\.v\z|\Avfncvt(?:\.rtz)?\.x(?:u)?\.f\.w\z/) -%>
  <%- segment_match = inst.name.downcase.match(/\Av(?:l(?:s|ux|ox)?|s(?:s|ux|ox)?)seg([2-8])e(i?)(8|16|32|64)(?:ff)?\.v\z/) -%>
  <%- segment_fields = segment_match && segment_match[1] -%>
  <%- segment_indexed = segment_match && segment_match[2] == "i" -%>
  <%- segment_eew = segment_match && segment_match[3] -%>
  <%- segment_base_operand = inst.name.downcase.start_with?("vl") ? "vd" : "vs3" -%>
  <%- gather_instruction = inst.name.downcase.match?(/\Avrgather(?:ei16)?\.(?:vv|vx|vi)\z/) -%>
  <%- viota_instruction = inst.name.downcase == "viota.m" -%>
  <%- slideup_instruction = inst.name.downcase.match?(/\Av(?:f)?slide(?:1)?up\./) -%>
  <%- unit_load_match = inst.name.downcase.match(/\Avle(8|16|32|64)\.v\z/) -%>
  <%- widening_instruction = inst.name.downcase.match?(/\Av(?:f)?w/) -%>
  <%- widening_reduction_instruction = inst.name.downcase.match?(/\Av(?:f|w|fw)?red/) -%>
  <%- widening_wide_vs2_instruction = widening_instruction && inst.name.downcase.match?(/\.w(?:v|x|f)\z/) -%>
  <%- widening_wv_instruction = widening_wide_vs2_instruction && inst.name.downcase.end_with?(".wv") -%>
  <%- widening_vv_instruction = widening_instruction && inst.name.downcase.end_with?(".vv") -%>
  <%- narrowing_shift_instruction = inst.name.downcase.match?(/\Avn(?:clipu?|sra|srl)\.wv\z/) -%>
  <%- extension_match = inst.name.downcase.match(/\Av[sz]ext\.vf([248])\z/) -%>
  template <unsigned XLEN, SocModel SocType>
  class <%= name_of(:inst, cfg_arch, inst.name) %> : public InstWithKnownLength<XLEN, <%= inst.encoding_width %>> {


    // normal allocation is disallowed (pool allocator)
    void* operator new(size_t size) = delete;

   public:
    // we use placement allocation via the pool allocator
    void * operator new (std::size_t, void * p) throw() { return p ; }

    void operator delete(void* ptr);

  public:
    using XReg = Bits<<%= cfg_arch.possible_xlens.max %>>;
    static constexpr unsigned EncodingLength = <%= inst.encoding_width %>;
    <%= name_of(:inst, cfg_arch, inst.name) %>(<%= name_of(:hart, cfg_arch) %><SocType>* parent, XReg pc, Bits<<%= inst.encoding_width %>> encoding)
      : InstWithKnownLength<XLEN, <%= inst.encoding_width %>>(pc, encoding),
        m_parent(parent)
    {
    }

    virtual ~<%= name_of(:inst, cfg_arch, inst.name) %>() {}

    <%= name_of(:hart, cfg_arch) %><SocType>* parent() { return m_parent; }

    bool control_flow() const override {
      <%- if inst.operation_ast.nil? -%>
      return false;
      <%- else -%>
      <%- if !inst.base.nil? -%>
        <%- pruned_ast = inst.pruned_operation_ast(inst.base) -%>
        return <%= pruned_ast.control_flow?(cfg_arch.symtab) %>;
      <%- elsif !cfg_arch.multi_xlen? -%>
        <%- pruned_ast = inst.pruned_operation_ast(cfg_arch.possible_xlens[0]) -%>
        return <%= pruned_ast.control_flow?(cfg_arch.symtab) %>;
      <%- else -%>
        if (m_parent->xlen() == 32_b) {
          <%- pruned_ast = inst.pruned_operation_ast(32) -%>
          return <%= pruned_ast.control_flow?(cfg_arch.symtab) %>;
        } else {
          <%- pruned_ast = inst.pruned_operation_ast(64) -%>
          return <%= pruned_ast.control_flow?(cfg_arch.symtab) %>;
        }
      <%- end -%>
      <%- end -%>
    }

    //
    // Decode variables
    //
    <%- if needs_rv32 && needs_rv64 -%>
    <%- inst.decode_variables(32).each do |dv| -%>
    template <unsigned _XLEN = XLEN>
    Bits<<%= dv.size %>> <%= dv.name %>() const requires (_XLEN==32) {
      return <%= extract_decode(dv,inst) %>;
    }
    <%- end -%>
    <%- inst.decode_variables(64).each do |dv| -%>
    template <unsigned _XLEN = XLEN>
    Bits<<%= dv.size %>> <%= dv.name %>() const requires (_XLEN==64) {
      return <%= extract_decode(dv,inst) %>;
    }
    <%- end -%>
    <%- elsif needs_rv32 -%>
    <%- inst.decode_variables(32).each do |dv| -%>
    Bits<<%= dv.size %>> <%= dv.name %>() const {
      return <%= extract_decode(dv,inst) %>;
    }
    <%- end -%>
    <%- else -%>
    <%- inst.decode_variables(64).each do |dv| -%>
    Bits<<%= dv.size %>> <%= dv.name %>() const {
      return <%= extract_decode(dv,inst) %>;
    }
    <%- end -%>
    <%- end -%>

    void execute() override {

      <%- if inst.operation_ast.nil? -%>
        m_parent->assert(false, "There is no operation() defined for this instruction");
      <%- else -%>
      <%- if vector_instruction && whole_register_vector_instruction -%>
      m_parent->check_v_state_enabled(this->_encoding());
      <%- elsif vector_instruction -%>
      m_parent->check_v_ok(this->_encoding());
      <%- if vector_fp_instruction -%>
      m_parent->check_v_fp_sew(this->_encoding());
      <%- end -%>
      <%- if segment_match -%>
      m_parent->check_vector_segment_register_group(<%= segment_base_operand %>(), _Bits<32, false>(<%= segment_fields %>_b), <%= segment_indexed ? "m_parent->vector_state().sew" : "_Bits<32, false>(#{segment_eew}_b)" %>, this->_encoding());
      <%- if segment_indexed -%>
      m_parent->check_vector_segment_register_group(vs2(), _Bits<32, false>(1_b), _Bits<32, false>(<%= segment_eew %>_b), this->_encoding());
      <%- if segment_base_operand == "vd" -%>
      m_parent->check_vector_register_groups_no_overlap(<%= segment_base_operand %>(), _Bits<32, false>(<%= segment_fields %>_b), m_parent->vector_state().sew, vs2(), _Bits<32, false>(1_b), _Bits<32, false>(<%= segment_eew %>_b), this->_encoding());
      <%- end -%>
      <%- end -%>
      <%- end -%>
      <%- if unit_load_match -%>
      m_parent->check_vector_segment_register_group(vd(), _Bits<32, false>(1_b), _Bits<32, false>(<%= unit_load_match[1] %>_b), this->_encoding());
      <%- end -%>
      <%- if gather_instruction -%>
      m_parent->check_vector_register_group_no_overlap(vd(), vs2(), this->_encoding());
      <%- if decode_variable_names.include?("vs1") -%>
      m_parent->check_vector_register_group_no_overlap(vd(), vs1(), this->_encoding());
      <%- end -%>
      <%- end -%>
      <%- if viota_instruction -%>
      m_parent->check_vector_register_group_no_overlap(vd(), vs2(), this->_encoding());
      <%- end -%>
      <%- if slideup_instruction -%>
      m_parent->check_vector_register_group_no_overlap(vd(), vs2(), this->_encoding());
      <%- end -%>
      <%- if widening_instruction -%>
      m_parent->check_vector_widening_sew(this->_encoding());
      <%- if widening_reduction_instruction -%>
      m_parent->check_vector_widening_reduction_source_overlap(vs2(), vs1(), this->_encoding());
      <%- else -%>
      <%- unless widening_wide_vs2_instruction -%>
      m_parent->check_vector_widening_register_group_overlap(vd(), m_parent->vector_state().sew << _Bits<1, false>(1_b), vs2(), m_parent->vector_state().sew, this->_encoding());
      <%- end -%>
      <%- if widening_vv_instruction || widening_wv_instruction -%>
      m_parent->check_vector_widening_register_group_overlap(vd(), m_parent->vector_state().sew << _Bits<1, false>(1_b), vs1(), m_parent->vector_state().sew, this->_encoding());
      <%- end -%>
      <%- if widening_wv_instruction -%>
      m_parent->check_vector_register_groups_no_overlap(vs2(), _Bits<32, false>(1_b), m_parent->vector_state().sew << _Bits<1, false>(1_b), vs1(), _Bits<32, false>(1_b), m_parent->vector_state().sew, this->_encoding());
      <%- end -%>
      <%- end -%>
      <%- end -%>
      <%- if narrowing_shift_instruction -%>
      m_parent->check_vector_register_groups_no_overlap(vs2(), _Bits<32, false>(1_b), m_parent->vector_state().sew << _Bits<1, false>(1_b), vs1(), _Bits<32, false>(1_b), m_parent->vector_state().sew, this->_encoding());
      <%- end -%>
      <%- if extension_match -%>
      m_parent->check_vector_extension_sew(_Bits<32, false>(<%= extension_match[1] %>_b), this->_encoding());
      m_parent->check_vector_widening_register_group_overlap(vd(), m_parent->vector_state().sew, vs2(), m_parent->vector_state().sew / _Bits<32, false>(<%= extension_match[1] %>_b), this->_encoding());
      <%- end -%>
      <%- if decode_variable_names.include?("vm") || implicit_v0_mask -%>
      <%- vector_register_operands.each do |operand| -%>
      <%- next if operand == "vd" && (mask_result_instruction || reduction_instruction) -%>
      m_parent->check_masked_vector_register_overlap(<%= decode_variable_names.include?("vm") ? "vm()" : "_Bits<1, false>(0_b)" %>, <%= operand %>(), this->_encoding());
      <%- end -%>
      <%- end -%>
      <%- elsif vector_state_instruction -%>
      m_parent->check_v_state_enabled(this->_encoding());
      <%- end -%>
      <%- if !inst.base.nil? -%>
        <%- pruned_ast = inst.pruned_operation_ast(inst.base) -%>
        <%- symtab = inst.fill_symtab(inst.base, pruned_ast) -%>
        <%= pruned_ast.gen_cpp(symtab, 6) %>
        <%- symtab.release -%>
      <%- elsif !cfg_arch.multi_xlen? -%>
        <%- pruned_ast = inst.pruned_operation_ast(cfg_arch.possible_xlens[0]) -%>
        <%- symtab = inst.fill_symtab(cfg_arch.possible_xlens[0], pruned_ast) -%>
        <%= pruned_ast.gen_cpp(symtab, 6) %>
        <%- symtab.release -%>
      <%- else -%>
      if (m_parent->xlen() == 32_b) {
        <%- pruned_ast = inst.pruned_operation_ast(32) -%>
        <%- symtab = inst.fill_symtab(32, pruned_ast) -%>
        <%= pruned_ast.gen_cpp(symtab, 8) %>
        <%- symtab.release -%>
      } else {
        <%- pruned_ast = inst.pruned_operation_ast(64) -%>
        <%- symtab = inst.fill_symtab(64, pruned_ast) -%>
        <%= pruned_ast.gen_cpp(symtab, 8) %>
        <%- symtab.release -%>
      }
      <%- end -%>
      <%- end -%>
      <%- if vector_state_instruction -%>
      m_parent->mark_v_state_dirty();
      <%- end -%>
    }

    constexpr static std::string_view m_name = "<%= inst.name %>";
    const std::string_view& name() override { return m_name; }
    std::string disassemble(bool use_abi_reg_names = 0) const override {
      if constexpr (XLEN == 32) {
        <%- if inst.defined_in_base?(32) -%>
        return fmt::format("{} <%= inst.assembly_fmt(32) %>", m_name <%= inst.assembly_fmt_args(32) %>);
        <%- else -%>
        udb_assert(false, "Not defined");
        __builtin_unreachable();
        <%- end -%>
      } else {
        <%- if inst.defined_in_base?(64) -%>
        return fmt::format("{} <%= inst.assembly_fmt(64) %>", m_name <%= inst.assembly_fmt_args(64) %>);
        <%- else -%>
        udb_assert(false, "Not defined");
        __builtin_unreachable();
        <%- end -%>
      }
    }
    std::vector<Reg> srcRegs() const override {
      <%- if inst.operation_ast.nil? -%>
        m_parent->assert(false, "There is no operation() defined for this instruction");
        __builtin_unreachable();
      <%- else -%>
      <%- src_regs = nil -%>
      <%- if !inst.base.nil? -%>
        <%- pruned_ast = inst.pruned_operation_ast(inst.base) -%>
        <%- symtab = inst.fill_symtab(inst.base, pruned_ast) -%>
            <%- begin -%>
        <%- src_regs = pruned_ast.find_src_registers(symtab) %>
        <%- symtab.release -%>
        return {<%= src_regs.map { |rf_name, idx| idx.is_a?(Integer) ? "{Reg::#{rf_name}#{idx}}" : "{Reg::from_rf_index(#{idx}, #{rf_enum_base(rf_name)}u)}" }.join(", ") %>};
      <%- rescue Idl::ComplexRegDetermination -%>
        throw ComplexRegDetermination();
      <%- end -%>
      <%- elsif !cfg_arch.multi_xlen? -%>
        <%- pruned_ast = inst.pruned_operation_ast(cfg_arch.possible_xlens[0]) -%>
        <%- symtab = inst.fill_symtab(cfg_arch.possible_xlens[0], pruned_ast) -%>
            <%- begin -%>
        <%- src_regs = pruned_ast.find_src_registers(symtab) %>
        <%- symtab.release -%>
        return {<%= src_regs.map { |rf_name, idx| idx.is_a?(Integer) ? "{Reg::#{rf_name}#{idx}}" : "{Reg::from_rf_index(#{idx}, #{rf_enum_base(rf_name)}u)}" }.join(", ") %>};
      <%- rescue Idl::ComplexRegDetermination -%>
        throw ComplexRegDetermination();
      <%- end -%>
      <%- else -%>
        if (m_parent->xlen() == 32_b) {
        <%- pruned_ast = inst.pruned_operation_ast(32) -%>
        <%- symtab = inst.fill_symtab(32, pruned_ast) -%>
            <%- begin -%>
        <%- src_regs = pruned_ast.find_src_registers(symtab) %>
        <%- symtab.release -%>
        return {<%= src_regs.map { |rf_name, idx| idx.is_a?(Integer) ? "{Reg::#{rf_name}#{idx}}" : "{Reg::from_rf_index(#{idx}, #{rf_enum_base(rf_name)}u)}" }.join(", ") %>};
      <%- rescue Idl::ComplexRegDetermination -%>
        throw ComplexRegDetermination();
      <%- end -%>
      } else {
        <%- pruned_ast = inst.pruned_operation_ast(64) -%>
        <%- symtab = inst.fill_symtab(64, pruned_ast) -%>
            <%- begin -%>
        <%- src_regs = pruned_ast.find_src_registers(symtab) %>
        <%- symtab.release -%>
        return {<%= src_regs.map { |rf_name, idx| idx.is_a?(Integer) ? "{Reg::#{rf_name}#{idx}}" : "{Reg::from_rf_index(#{idx}, #{rf_enum_base(rf_name)}u)}" }.join(", ") %>};
      <%- rescue Idl::ComplexRegDetermination -%>
        throw ComplexRegDetermination();
      <%- end -%>
      }
      <%- end -%>
      <%- end -%>
    }

    std::vector<Reg> dstRegs() const override {
      <%- if inst.operation_ast.nil? -%>
        m_parent->assert(false, "There is no operation() defined for this instruction");
        __builtin_unreachable();
      <%- else -%>
      <%- dst_regs = nil -%>
      <%- if !inst.base.nil? -%>
        <%- pruned_ast = inst.pruned_operation_ast(inst.base) -%>
        <%- symtab = inst.fill_symtab(inst.base, pruned_ast) -%>
            <%- begin -%>
        <%- dst_regs = pruned_ast.find_dst_registers(symtab) %>
        <%- symtab.release -%>
        return {<%= dst_regs.map { |rf_name, idx| idx.is_a?(Integer) ? "{Reg::#{rf_name}#{idx}}" : "{Reg::from_rf_index(#{idx}, #{rf_enum_base(rf_name)}u)}" }.join(", ") %>};
      <%- rescue Idl::ComplexRegDetermination -%>
        throw ComplexRegDetermination();
      <%- end -%>
      <%- elsif !cfg_arch.multi_xlen? -%>
        <%- pruned_ast = inst.pruned_operation_ast(cfg_arch.possible_xlens[0]) -%>
        <%- symtab = inst.fill_symtab(cfg_arch.possible_xlens[0], pruned_ast) -%>
            <%- begin -%>
        <%- dst_regs = pruned_ast.find_dst_registers(symtab) %>
        <%- symtab.release -%>
        return {<%= dst_regs.map { |rf_name, idx| idx.is_a?(Integer) ? "{Reg::#{rf_name}#{idx}}" : "{Reg::from_rf_index(#{idx}, #{rf_enum_base(rf_name)}u)}" }.join(", ") %>};
      <%- rescue Idl::ComplexRegDetermination -%>
        throw ComplexRegDetermination();
      <%- end -%>
      <%- else -%>
        if (m_parent->xlen() == 32_b) {
        <%- pruned_ast = inst.pruned_operation_ast(32) -%>
        <%- symtab = inst.fill_symtab(32, pruned_ast) -%>
            <%- begin -%>
        <%- dst_regs = pruned_ast.find_dst_registers(symtab) %>
        <%- symtab.release -%>
        return {<%= dst_regs.map { |rf_name, idx| idx.is_a?(Integer) ? "{Reg::#{rf_name}#{idx}}" : "{Reg::from_rf_index(#{idx}, #{rf_enum_base(rf_name)}u)}" }.join(", ") %>};
      <%- rescue Idl::ComplexRegDetermination -%>
        throw ComplexRegDetermination();
      <%- end -%>
      } else {
        <%- pruned_ast = inst.pruned_operation_ast(64) -%>
        <%- symtab = inst.fill_symtab(64, pruned_ast) -%>
            <%- begin -%>
        <%- dst_regs = pruned_ast.find_dst_registers(symtab) %>
        <%- symtab.release -%>
        return {<%= dst_regs.map { |rf_name, idx| idx.is_a?(Integer) ? "{Reg::#{rf_name}#{idx}}" : "{Reg::from_rf_index(#{idx}, #{rf_enum_base(rf_name)}u)}" }.join(", ") %>};
      <%- rescue Idl::ComplexRegDetermination -%>
        throw ComplexRegDetermination();
      <%- end -%>
      }
      <%- end -%>
      <%- end -%>
    }

  private:
    <%= name_of(:hart, cfg_arch) %><SocType> * const m_parent;
  };
  <%- end -%>

#undef __UDB_FUNC_CALL
#undef __UDB_CSR_BY_ADDR
#undef __UDB_CSR_BY_NAME
#undef __UDB_ENCODING
#undef __UDB_RUNTIME_PARAM
#undef __UDB_STATIC_PARAM
#undef __UDB_STRUCT
#undef __UDB_PC
#undef __UDB_MUTABLE_GLOBAL
#undef __UDB_CONSTEXPR_FUNC_CALL
#undef __UDB_SET_PC
#undef __UDB_CONST_GLOBAL
#undef __UDB_XLEN
#undef __UDB_HART
}
